#!/usr/bin/env bash
set -euo pipefail
VERSION="0.1.0"

# Store root. A relative override is made absolute so later `cd`s do not move it.
LEARN_HOME="${AGENT_LEARNINGS_HOME:-$HOME/.agent-learnings}"
case "$LEARN_HOME" in
  /*) ;;
  *) LEARN_HOME="$(pwd -P)/$LEARN_HOME" ;;
esac
STORE_HOME="$LEARN_HOME"

AREAS="test build deps git shell edit scope spec ui lang verbosity tool env infra"
KINDS="correction failure confirmation workflow"

# Small RU + EN words dropped from `learn dream`'s similarity tokenizer; they
# carry no topical signal and would otherwise inflate overlap scores.
DREAM_STOPWORDS='the and for with that this from are was not use uses used when into only via per its has have all any but can must should does never always для при как что это или так все его она они без под над про есть быть надо нужно если чтобы когда только уже еще вот'
export DREAM_STOPWORDS

# Set by main() from `learn <cmd> --profile <p> ...`: address a profile of the
# store directly instead of through ./.learnings (used by `learn dream`).
PROFILE_OVERRIDE=""

usage() {
  cat <<'EOF'
usage: learn <command> [args]        (learn --version prints the version)

commands:
  init [profile]                            set up the store and .learnings/ for this project (user-only)
  inbox [--since <ts>] [--kind k] [--tier t] [--all] [--json] [--limit N]
                                            show plugin events (unacked by default)
  ack [--until <ts>]                        mark the inbox as processed
  add --key <area.symptom> --kind <k> --summary "<=120" --evidence "..." [--project p] [--behavior "..."] [--owner o] [--date YYYY-MM-DD]
  add --from <file> [flags]                 create a candidate (seen: 1); the draft holds flat
                                            `field: value` lines (key kind summary evidence project
                                            behavior owner date); flags override it; a draft inside
                                            <store>/.drafts/ is deleted after success.
                                            --date is the event date (default today): it prefixes
                                            the evidence line and sets first-seen/last-seen
  bump <key> --evidence "..." [--project p] [--date YYYY-MM-DD]
                                            another sighting of a candidate (first-seen = min,
                                            last-seen = max of the dates)
  bump [<key>] --from <file> [flags]        same, from a draft (key evidence project date)
  propose <key> [--owner <o>]               status: proposed
  apply <key> --owner <o> --change-ref <r>  move to applied/ (only after user approval)
                                            owner: script:<path> | skill:<name> | new-skill:<name>
                                            | agents:<repo> | config:<path> | hint:<id>
  reject <key> --reason "..."               move to rejected/
  reject [<key>] --from <file> [--reason r] same, from a draft (key reason)
  index                                     rebuild INDEX.md from candidates/
  status                                    profile, counts, unacked inbox, git state
  doctor                                    check symlink, frontmatter, index, markers
  grep <pattern> [grep opts]                search candidates/applied/rejected
  prune [--days 90]                         seen=1 and idle candidates -> rejected (reason: stale);
                                            also deletes acked inbox/*.jsonl older than --days
  markers list | add --tier <t> "<re>" | test "<text>"
  dream --report [--stale-days N] [--profile <p>]
                                            read-only whole-store report: unacked inbox, similar
                                            candidates, ready for proposal, stale, unusable
  dream [--profile <p>] [--model <provider/model>] [--if-changed] [--print-config]
                                            consolidate the store with a sandboxed OpenCode run
                                            (AGENT_LEARNINGS_DREAM_MODEL sets the default model)
  backup [--push]                           commit (and push) the store
  install-opencode                          install the global OpenCode plugin

profile-bound commands (inbox ack add bump propose apply reject index status doctor
grep prune) take `--profile <p>` as their first argument to address a store profile
without a ./.learnings symlink, e.g. `learn inbox --profile work --all`.
EOF
}

die() { echo "learn: $*" >&2; exit 1; }
warn() { echo "learn: $*" >&2; }

canonical_path() {
  local path="$1" dir target hops=0
  while [ -L "$path" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || { echo "learn: too many levels of symbolic links: $1" >&2; return 1; }
    dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
    target="$(readlink "$path")"
    case "$target" in /*) path="$target" ;; *) path="$dir/$target" ;; esac
  done
  dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

SCRIPT_PATH="$(canonical_path "${BASH_SOURCE[0]}")" || die "cannot resolve CLI path"
SKILL_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
OPENCODE_DIR="$SKILL_DIR/opencode"

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------

valid_slug() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }
valid_key() { [[ "$1" =~ ^[a-z]+\.[a-z0-9-]+$ ]]; }
valid_owner() { [[ "$1" =~ ^(script|skill|new-skill|agents|config|hint):.+ ]]; }

require_slug() {
  valid_slug "$2" || die "invalid $1 '$2': use lowercase letters, digits, and hyphens"
}

in_list() {   # in_list <word> <space separated list>
  case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Collapse newlines/tabs to spaces and trim, so values stay on one line.
oneline() {
  local s
  s="$(printf '%s' "$1" | tr '\n\r\t' '   ')"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Length in characters (not bytes) of a UTF-8 string: count non-continuation bytes.
char_len() {
  printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

is_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

valid_calendar_date() {
  local date="$1" year month day rest y d max
  case "$date" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) return 1 ;;
  esac
  year="${date%%-*}"
  rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  d=$((10#$day))
  case "$month" in
    01|03|05|07|08|10|12) max=31 ;;
    04|06|09|11) max=30 ;;
    02)
      y=$((10#$year))
      if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then
        max=29
      else
        max=28
      fi
      ;;
    *) return 1 ;;
  esac
  [ "$d" -ge 1 ] && [ "$d" -le "$max" ]
}

# Days-from-civil: monotonic day number for a validated YYYY-MM-DD date.
days_from_civil() {
  local date="$1" year month day y m d era yoe mp doy doe rest
  year="${date%%-*}"
  rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  y=$((10#$year)); m=$((10#$month)); d=$((10#$day))
  if [ "$m" -le 2 ]; then y=$((y - 1)); fi
  if [ "$y" -ge 0 ]; then era=$((y / 400)); else era=$(((y - 399) / 400)); fi
  yoe=$((y - era * 400))
  mp=$(((m + 9) % 12))
  doy=$(((153 * mp + 2) / 5 + d - 1))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  echo $((era * 146097 + doe - 719468))
}

today() {
  if [ -n "${LEARN_TODAY:-}" ]; then
    valid_calendar_date "$LEARN_TODAY" || die "invalid LEARN_TODAY: $LEARN_TODAY"
    printf '%s' "$LEARN_TODAY"
  else
    date +%Y-%m-%d
  fi
}

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Temp file next to its destination so the final mv is an atomic rename.
mk_tmp() {
  local t
  t="$(mktemp "$1/.learn.XXXXXX")" || die "cannot create temporary file in $1"
  chmod 644 "$t"
  printf '%s\n' "$t"
}

# ---------------------------------------------------------------------------
# store / profile resolution
# ---------------------------------------------------------------------------

is_in_store() {
  case "$1" in "$STORE_HOME"|"$STORE_HOME"/*) return 0 ;; *) return 1 ;; esac
}

load_store() {
  [ -d "$LEARN_HOME" ] || die "no store at $LEARN_HOME (ask the user to run: learn init <profile>)"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
}

# Sets PROFILE and PDIR (canonical profile dir) from ./.learnings.
resolve_profile() {
  local target
  if [ -n "$PROFILE_OVERRIDE" ]; then
    require_slug "profile name" "$PROFILE_OVERRIDE"
    load_store
    PROFILE="$PROFILE_OVERRIDE"
    [ -d "$STORE_HOME/$PROFILE" ] || die "no such profile in the store: $PROFILE"
    PDIR="$(cd -P "$STORE_HOME/$PROFILE" && pwd -P)"
    is_in_store "$PDIR" || die "unsafe profile directory: $PDIR is outside $STORE_HOME"
    mkdir -p "$PDIR/inbox" "$PDIR/candidates" "$PDIR/applied" "$PDIR/rejected"
    return 0
  fi
  [ -L .learnings ] || die "no .learnings symlink here (ask the user to run: learn init <profile>)"
  load_store
  target="$(readlink .learnings)"
  PROFILE="$(basename "$target")"
  [ -d .learnings ] || die "broken .learnings symlink -> $target (ask the user to run: learn init <profile>)"
  PDIR="$(cd -P .learnings && pwd -P)"
  is_in_store "$PDIR" || die "unsafe .learnings symlink: $target is outside $STORE_HOME"
  mkdir -p "$PDIR/inbox" "$PDIR/candidates" "$PDIR/applied" "$PDIR/rejected"
}

default_project() {
  if [ -n "${LEARN_PROJECT:-}" ]; then printf '%s' "$LEARN_PROJECT"; else basename "$(pwd -P)"; fi
}

validate_project() {
  case "$1" in
    ''|*,*|*\[*|*\]*|*$'\n'*) die "invalid project '$1': must be non-empty without commas or brackets" ;;
  esac
}

ensure_global_gitignore() {
  local f origin source
  f="$(git config --global --path --get core.excludesfile 2>/dev/null || true)"
  if [ -z "$f" ]; then
    f="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  else
    case "$f" in
      /*) ;;
      *)
        origin="$(git config --global --show-origin --get core.excludesfile 2>/dev/null || true)"
        source="${origin%%$'\t'*}"
        source="${source#file:}"
        [ -n "$source" ] || die "cannot resolve global core.excludesfile"
        f="$(dirname "$source")/$f"
        ;;
    esac
  fi
  f="${f/#\~/$HOME}"
  # `.learnings` is a symlink, which git treats as a file: a trailing-slash pattern
  # (`.learnings/`) only matches directories and would leave it untracked-but-visible.
  if [ -f "$f" ] && grep -qxF '.learnings' "$f"; then return 0; fi
  mkdir -p "$(dirname "$f")"
  if [ -f "$f" ] && grep -qxF '.learnings/' "$f"; then
    local tmp
    tmp="$(mk_tmp "$(dirname "$f")")"
    awk '$0 == ".learnings/" { print ".learnings"; next } { print }' "$f" > "$tmp" && mv "$tmp" "$f"
    git config --global core.excludesfile "$f"
    echo "fixed global gitignore ($f): '.learnings/' -> '.learnings' (it is a symlink)"
    return 0
  fi
  if [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ]; then printf '\n' >> "$f"; fi
  printf '.learnings\n' >> "$f"
  git config --global core.excludesfile "$f"
  echo "added '.learnings' to global gitignore ($f)"
}

# ---------------------------------------------------------------------------
# frontmatter
# ---------------------------------------------------------------------------

# Value of one flat frontmatter key; only the first ---...--- block is read.
fm_get() {
  awk -v k="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    /^---$/ { exit }
    index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }
  ' "$1"
}

# Set (replace or append inside the block) one frontmatter key; atomic.
fm_set() {   # fm_set <file> <key> <value>
  local f="$1" tmp
  tmp="$(mk_tmp "$(dirname "$f")")"
  if ! FM_KEY="$2" FM_VAL="$3" awk '
    BEGIN { k = ENVIRON["FM_KEY"]; v = ENVIRON["FM_VAL"]; state = 0; done = 0; bad = 0 }
    NR == 1 { if ($0 != "---") bad = 1; state = 1; print; next }
    state == 1 && /^---$/ { if (!done) { print k ": " v; done = 1 } state = 2; print; next }
    state == 1 && index($0, k ": ") == 1 { if (!done) { print k ": " v; done = 1 } next }
    { print }
    END { if (bad || state != 2) exit 3 }
  ' "$f" > "$tmp"; then
    rm -f "$tmp"
    die "cannot update frontmatter of $f"
  fi
  mv "$tmp" "$f"
}

# Append a line to the file (creating "## Evidence" when absent); atomic.
append_evidence() {   # append_evidence <file> <line>
  local f="$1" tmp
  tmp="$(mk_tmp "$(dirname "$f")")"
  cat "$f" > "$tmp"
  if [ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ]; then printf '\n' >> "$tmp"; fi
  if ! grep -q '^## Evidence$' "$tmp"; then printf '\n## Evidence\n' >> "$tmp"; fi
  printf '%s\n' "$2" >> "$tmp"
  mv "$tmp" "$f"
}

fm_has_block() {
  awk 'NR == 1 { if ($0 != "---") exit 1; next } /^---$/ { f = 1; exit } END { exit !f }' "$1"
}

# Structural problems that make an entry unusable for INDEX.md. One per line.
entry_problems() {
  local f="$1" base stem v key
  base="$(basename "$f")"; stem="${base%.md}"
  if ! fm_has_block "$f"; then echo "BAD FRONTMATTER (missing or unterminated ---): $f"; return 0; fi
  [ -n "$(fm_get "$f" description)" ] || echo "BAD FRONTMATTER (missing description): $f"
  key="$(fm_get "$f" pattern-key)"
  [ "$key" = "$stem" ] || echo "BAD FRONTMATTER (pattern-key '$key' does not match filename): $f"
  v="$(fm_get "$f" kind)"
  in_list "$v" "$KINDS" || echo "BAD FRONTMATTER (missing or invalid kind '$v'): $f"
  v="$(fm_get "$f" seen)"
  is_uint "$v" || echo "BAD FRONTMATTER (seen is not a number): $f"
  v="$(fm_get "$f" first-seen)"
  valid_calendar_date "$v" || echo "BAD FRONTMATTER (invalid first-seen): $f"
  v="$(fm_get "$f" last-seen)"
  valid_calendar_date "$v" || echo "BAD FRONTMATTER (invalid last-seen): $f"
  return 0
}

# Which directory holds the key: candidates | applied | rejected | (empty).
find_key() {
  local d
  for d in candidates applied rejected; do
    if [ -f "$PDIR/$d/$1.md" ]; then printf '%s' "$d"; return 0; fi
  done
  return 0
}

validate_key() {
  local key="$1" area
  valid_key "$key" || die "invalid key '$key': use <area>.<symptom> (lowercase, digits, hyphens), e.g. test.wrong-cwd"
  area="${key%%.*}"
  in_list "$area" "$AREAS" || warn "warning: area '$area' is not in the vocabulary ($AREAS)"
  return 0
}

# ---------------------------------------------------------------------------
# INDEX.md
# ---------------------------------------------------------------------------

# INDEX.md content: one line per usable candidate, sorted by key (LC_ALL=C).
render_index() {
  local f base key kind seen desc problems
  {
    for f in "$PDIR"/candidates/*.md; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      key="${base%.md}"
      problems="$(entry_problems "$f")"
      if [ -n "$problems" ]; then
        warn "skipping candidates/$base: $(printf '%s' "$problems" | head -n 1)"
        continue
      fi
      kind="$(fm_get "$f" kind)"
      seen="$(fm_get "$f" seen)"
      desc="$(fm_get "$f" description)"
      printf '%s\t- [%s](candidates/%s) — %s ×%s: %s\n' "$key" "$key" "$base" "$kind" "$seen" "$desc"
    done
  } | LC_ALL=C sort -t "$(printf '\t')" -k1,1 | cut -f2-
}

write_index() {
  local tmp
  tmp="$(mk_tmp "$PDIR")"
  if ! render_index > "$tmp"; then rm -f "$tmp"; die "failed to render INDEX.md"; fi
  mv "$tmp" "$PDIR/INDEX.md"
}

cmd_index() {
  [ $# -eq 0 ] || die "usage: learn index"
  resolve_profile
  write_index
  echo "indexed $PROFILE ($(grep -c '^- \[' "$PDIR/INDEX.md" || true) candidates)"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local profile="" item found suggestion target
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "unknown option: $1" ;;
      *)
        [ -z "$profile" ] || die "usage: learn init <profile>"
        profile="$1"; shift ;;
    esac
  done
  if [ -z "$profile" ]; then
    {
      echo "existing profiles:"
      found=0
      if [ -d "$LEARN_HOME" ]; then
        for item in "$LEARN_HOME"/*/; do
          [ -d "$item" ] || continue
          item="${item%/}"
          echo "  $(basename "$item")"
          found=1
        done
      fi
      [ "$found" -eq 1 ] || echo "  (none)"
      target="$(readlink .opencode 2>/dev/null || true)"
      case "$target" in
        */opencode/*)
          suggestion="${target##*/opencode/}"
          suggestion="${suggestion%%/*}"
          [ -z "$suggestion" ] || echo "suggested (from .opencode -> $target): learn init $suggestion"
          ;;
      esac
      echo "usage: learn init <profile>"
    } >&2
    exit 1
  fi
  require_slug "profile name" "$profile"

  mkdir -p "$LEARN_HOME"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
  local pdir="$STORE_HOME/$profile"

  if [ -e .learnings ] || [ -L .learnings ]; then
    [ -L .learnings ] || die ".learnings exists but is not a symlink"
    if [ -d .learnings ]; then
      local existing
      existing="$(cd -P .learnings && pwd -P)"
      [ "$existing" = "$pdir" ] || die ".learnings is bound to $existing; remove it explicitly before initializing '$profile'"
    fi
  fi

  if [ ! -d "$STORE_HOME/.git" ]; then git -C "$STORE_HOME" init -q; fi
  ensure_store_excludes
  mkdir -p "$pdir/inbox" "$pdir/candidates" "$pdir/applied" "$pdir/rejected"
  [ -f "$pdir/INDEX.md" ] || : > "$pdir/INDEX.md"

  if [ ! -f "$STORE_HOME/markers.json" ]; then
    local seed="$OPENCODE_DIR/markers.personal.default.json" tmp
    tmp="$(mk_tmp "$STORE_HOME")"
    if [ -f "$seed" ]; then
      cat "$seed" > "$tmp"
    else
      printf '%s\n' '{"version":1,"correction":{"strong":[],"medium":[],"weak":[]},"confirmation":[]}' > "$tmp"
    fi
    mv "$tmp" "$STORE_HOME/markers.json"
  fi

  ln -sfn "$pdir" .learnings
  ensure_global_gitignore
  echo "initialized: profile '$profile' at $pdir"
}

# ---------------------------------------------------------------------------
# inbox / ack
# ---------------------------------------------------------------------------

# Filtered inbox events, globally sorted by arrival key (stable; line order inside
# a jsonl file is not guaranteed because sessions append concurrently).
# Usage: inbox_stream <mode raw|compact> <since> <ack> <kind> <tier> [limit] [keyed]
# The key is `ats` (time the event entered the inbox; set by backfills) when
# present, else `ts`. Sorting, --limit, and ack filtering use the key; --since
# filters on `ts` (event time). Timestamps are ISO-8601 UTC strings, so string
# comparison orders them.
# limit (optional, > 0): the oldest N events, extended to every event that shares
# the Nth event's key, so `ack --until <trailer key>` never hides an unseen event.
# keyed (optional, 1): keep the leading `key<TAB>` on every output line.
inbox_stream() {
  local f tab=$'\t'
  local -a files=()
  for f in "$PDIR"/inbox/*.jsonl; do
    [ -e "$f" ] || continue
    files+=("$f")
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  IN_MODE="$1" IN_SINCE="$2" IN_ACK="$3" IN_KIND="$4" IN_TIER="$5" awk '
    function jget(s, name,   pat, i, n, c, out, len) {
      # Tolerate `"key": "v"` (spaced JSON) as well as the compact `"key":"v"`.
      pat = "\"" name "\"[ \t]*:[ \t]*\""
      if (!match(s, pat)) return ""
      i = RSTART + RLENGTH
      len = length(s)
      out = ""
      for (n = i; n <= len; n++) {
        c = substr(s, n, 1)
        if (c == "\\") {
          n++
          c = substr(s, n, 1)
          if (c == "n" || c == "t" || c == "r") c = " "
          out = out c
        } else if (c == "\"") {
          break
        } else {
          out = out c
        }
      }
      return out
    }
    BEGIN {
      mode = ENVIRON["IN_MODE"]; since = ENVIRON["IN_SINCE"]; ack = ENVIRON["IN_ACK"]
      wkind = ENVIRON["IN_KIND"]; wtier = ENVIRON["IN_TIER"]
    }
    /^[[:space:]]*$/ { next }
    {
      ts = jget($0, "ts"); kind = jget($0, "kind"); tier = jget($0, "tier")
      key = jget($0, "ats"); if (key == "") key = ts
      if (since != "" && ts < since) next
      if (ack != "" && key <= ack) next
      if (wkind != "" && kind != wkind) next
      if (wtier != "" && tier != wtier) next
      # key<TAB>payload: neither key nor payload holds a literal tab (JSON escapes
      # tabs; jget turns \t into a space), so the tab is a safe sort key separator.
      if (mode == "raw") { print key "\t" $0; next }
      project = jget($0, "project")
      if (kind == "failure") {
        text = jget($0, "tool") ": " jget($0, "head")
      } else {
        text = jget($0, "snippet")
        prev = jget($0, "prev_tool")
        if (prev != "") text = text "  (after " prev ")"
      }
      label = kind
      if (tier != "") label = kind "/" tier
      print key "\t" ts "  " label "  " project "  " text
    }
  ' "${files[@]}" | LC_ALL=C sort -t "$tab" -s -k1,1 | IN_LIMIT="${6:-}" IN_KEYED="${7:-}" awk '
    # No early `exit`: it would SIGPIPE the upstream sort and trip pipefail + set -e.
    BEGIN { limit = ENVIRON["IN_LIMIT"] + 0; keyed = (ENVIRON["IN_KEYED"] == "1"); n = 0; done = 0; last = "" }
    done { next }
    {
      i = index($0, "\t")
      key = substr($0, 1, i - 1)
      if (limit > 0 && n >= limit && key != last) { done = 1; next }
      if (keyed) print $0; else print substr($0, i + 1)
      n++; last = key
    }
  '
}

read_ack() {
  local ack=""
  if [ -f "$PDIR/inbox/.ack" ]; then IFS= read -r ack < "$PDIR/inbox/.ack" || true; fi
  printf '%s' "$ack"
}

cmd_inbox() {
  local since="" kind="" tier="" all=0 json=0 limit="" ack out maxts
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) [ $# -ge 2 ] || die "--since requires a value"; since="$2"; shift 2 ;;
      --kind) [ $# -ge 2 ] || die "--kind requires a value"; kind="$2"; shift 2 ;;
      --tier) [ $# -ge 2 ] || die "--tier requires a value"; tier="$2"; shift 2 ;;
      --all) all=1; shift ;;
      --json) json=1; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit requires a value"; limit="$2"; shift 2
        [[ "$limit" =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive integer" ;;
      *) die "usage: learn inbox [--since <ts>] [--kind k] [--tier t] [--all] [--json] [--limit N]" ;;
    esac
  done
  resolve_profile
  ack=""
  if [ "$all" -eq 0 ]; then ack="$(read_ack)"; fi
  # --limit N: oldest N events, extended to ties (see inbox_stream).
  if [ "$json" -eq 1 ]; then
    inbox_stream raw "$since" "$ack" "$kind" "$tier" "$limit"
  else
    out="$(inbox_stream compact "$since" "$ack" "$kind" "$tier" "$limit" 1)"
    if [ -n "$out" ]; then
      # Lines are `key<TAB>display`: the trailer comes from the key (ats or ts),
      # the display keeps ts first.
      printf '%s\n' "$out" | cut -f2-
      maxts="$(printf '%s\n' "$out" | cut -f1 | LC_ALL=C sort | tail -n 1)"
      echo "ack: learn ack --until $maxts" >&2
    else
      echo "(no events)"
    fi
  fi
}

cmd_ack() {
  local until_ts=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --until) [ $# -ge 2 ] || die "--until requires a value"; until_ts="$2"; shift 2 ;;
      *) die "usage: learn ack [--until <ts>]" ;;
    esac
  done
  resolve_profile
  [ -n "$until_ts" ] || until_ts="$(now_utc)"
  [[ "$until_ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && until_ts="${until_ts}T00:00:00Z"
  [[ "$until_ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})$ ]] || die "invalid timestamp '$until_ts': use ISO-8601 with a timezone, e.g. 2026-09-30T12:00:00Z"
  local tmp
  tmp="$(mk_tmp "$PDIR/inbox")"
  printf '%s\n' "$until_ts" > "$tmp"
  mv "$tmp" "$PDIR/inbox/.ack"
  echo "acked inbox until $until_ts"
}

# ---------------------------------------------------------------------------
# candidate lifecycle
# ---------------------------------------------------------------------------

project_listed() {   # project_listed <list "[a, b]"> <project>
  local list="$1" p item
  p="$2"
  list="${list#\[}"; list="${list%\]}"
  local IFS=','
  for item in $list; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [ "$item" = "$p" ] && return 0
  done
  return 1
}

# --from <file> drafts: flat `field: value` lines (first match per field, value =
# everything after the first ": "). Keeps free text out of the shell command line.
draft_load() {   # draft_load <file>: die unless it is a readable regular file
  [ -f "$1" ] && [ -r "$1" ] || die "cannot read draft file: $1"
  # Inside `learn dream` (LEARN_DREAM=1, set by cmd_dream) drafts must live in
  # $STORE_HOME/.drafts/: the CLI runs outside the sandbox, so --from must not
  # become a way to read files the dream agent itself may not read.
  if [ "${LEARN_DREAM:-}" = 1 ]; then
    local real
    real="$(canonical_path "$1" 2>/dev/null)" || die "cannot read draft file: $1"
    case "$real" in
      "$STORE_HOME/.drafts/"*) ;;
      *) die "inside dream, --from must point into $STORE_HOME/.drafts/: $1" ;;
    esac
  fi
}

draft_fill() {   # draft_fill <file> <var> <field>: set <var> from the draft when it is empty
  [ -z "${!2}" ] || return 0
  local v
  v="$(awk -v k="$3" 'index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }' "$1")"
  printf -v "$2" '%s' "$v"
}

# Delete the draft after success, only when it lives in $STORE_HOME/.drafts/.
draft_cleanup() {   # draft_cleanup <file>
  local real
  real="$(canonical_path "$1" 2>/dev/null)" || return 0
  case "$real" in
    "$STORE_HOME/.drafts/"*) rm -f -- "$real" ;;
  esac
  return 0
}

cmd_add() {
  local key="" kind="" summary="" evidence="" project="" behavior="" owner="" from="" date=""
  local addusage='usage: learn add --key <area.symptom> --kind <k> --summary "<=120" --evidence "..." [--project p] [--behavior "..."] [--owner o] [--date YYYY-MM-DD] | --from <file>'
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || die "--from requires a value"; from="$2"; shift 2 ;;
      --date) [ $# -ge 2 ] || die "--date requires a value"; date="$2"; shift 2 ;;
      --key) [ $# -ge 2 ] || die "--key requires a value"; key="$2"; shift 2 ;;
      --kind) [ $# -ge 2 ] || die "--kind requires a value"; kind="$2"; shift 2 ;;
      --summary) [ $# -ge 2 ] || die "--summary requires a value"; summary="$2"; shift 2 ;;
      --evidence) [ $# -ge 2 ] || die "--evidence requires a value"; evidence="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project requires a value"; project="$2"; shift 2 ;;
      --behavior) [ $# -ge 2 ] || die "--behavior requires a value"; behavior="$2"; shift 2 ;;
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      *) die "$addusage" ;;
    esac
  done
  if [ -n "$from" ]; then
    draft_load "$from"
    local f
    for f in key kind summary evidence project behavior owner date; do draft_fill "$from" "$f" "$f"; done
    key="$(oneline "$key")"; kind="$(oneline "$kind")"; project="$(oneline "$project")"
  fi
  date="$(oneline "$date")"
  if [ -n "$date" ]; then valid_calendar_date "$date" || die "invalid date '$date': use YYYY-MM-DD"; fi
  [ -n "$key" ] && [ -n "$kind" ] && [ -n "$summary" ] && [ -n "$evidence" ] \
    || die "$addusage"
  resolve_profile
  validate_key "$key"
  in_list "$kind" "$KINDS" || die "invalid kind '$kind': use one of: $KINDS"
  summary="$(oneline "$summary")"
  local n
  n="$(char_len "$summary")"
  [ "$n" -le 120 ] || die "summary is $n characters (max 120)"
  [ -n "$summary" ] || die "summary must not be empty"
  evidence="$(oneline "$evidence")"
  [ -n "$evidence" ] || die "evidence must not be empty"
  behavior="$(oneline "$behavior")"
  [ -n "$behavior" ] || behavior="$summary"
  owner="$(oneline "$owner")"
  [ -n "$project" ] || project="$(default_project)"
  validate_project "$project"

  local existing reason o
  existing="$(find_key "$key")"
  case "$existing" in
    candidates) die "candidate '$key' already exists; use: learn bump $key --evidence \"...\"" ;;
    applied)
      o="$(fm_get "$PDIR/applied/$key.md" owner)"
      die "'$key' is already applied (owner: ${o:-unknown}); applied patterns never grow" ;;
    rejected)
      reason="$(fm_get "$PDIR/rejected/$key.md" reason)"
      if [ "$reason" = "stale" ]; then
        rm -f "$PDIR/rejected/$key.md"
      else
        die "'$key' was rejected (reason: ${reason:-unknown}); delete rejected/$key.md to re-add it"
      fi ;;
  esac

  local day tmp
  day="${date:-$(today)}"
  tmp="$(mk_tmp "$PDIR/candidates")"
  {
    echo "---"
    echo "description: $summary"
    echo "pattern-key: $key"
    echo "kind: $kind"
    echo "seen: 1"
    echo "first-seen: $day"
    echo "last-seen: $day"
    echo "projects: [$project]"
    if [ -n "$owner" ]; then echo "suggested-owner: $owner"; fi
    echo "status: candidate"
    echo "---"
    echo "## Future behavior"
    echo "$behavior"
    echo ""
    echo "## Evidence"
    echo "- $day $project: $evidence"
  } > "$tmp"
  mv "$tmp" "$PDIR/candidates/$key.md"
  write_index
  echo "added candidates/$key.md"
  if [ -n "$from" ]; then draft_cleanup "$from"; fi
}

cmd_bump() {
  local key="" evidence="" project="" from="" date=""
  local bumpusage='usage: learn bump <key> --evidence "..." [--project p] [--date YYYY-MM-DD] | --from <file>'
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || die "--from requires a value"; from="$2"; shift 2 ;;
      --date) [ $# -ge 2 ] || die "--date requires a value"; date="$2"; shift 2 ;;
      --evidence) [ $# -ge 2 ] || die "--evidence requires a value"; evidence="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project requires a value"; project="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "$bumpusage"; key="$1"; shift ;;
    esac
  done
  if [ -n "$from" ]; then
    draft_load "$from"
    draft_fill "$from" key key; draft_fill "$from" evidence evidence; draft_fill "$from" project project
    draft_fill "$from" date date
    key="$(oneline "$key")"; project="$(oneline "$project")"
  fi
  date="$(oneline "$date")"
  if [ -n "$date" ]; then valid_calendar_date "$date" || die "invalid date '$date': use YYYY-MM-DD"; fi
  [ -n "$key" ] && [ -n "$evidence" ] || die "$bumpusage"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  evidence="$(oneline "$evidence")"
  [ -n "$evidence" ] || die "evidence must not be empty"
  [ -n "$project" ] || project="$(default_project)"
  validate_project "$project"

  local existing o ref reason f seen projects day
  existing="$(find_key "$key")"
  case "$existing" in
    applied)
      o="$(fm_get "$PDIR/applied/$key.md" owner)"
      ref="$(fm_get "$PDIR/applied/$key.md" change-ref)"
      die "'$key' is already applied (owner: ${o:-unknown}, change-ref: ${ref:-unknown}); applied patterns never grow — if the behavior regressed, fix the owner" ;;
    rejected)
      reason="$(fm_get "$PDIR/rejected/$key.md" reason)"
      die "'$key' was rejected (reason: ${reason:-unknown}); not bumping" ;;
    "") die "no candidate '$key' (create it with: learn add --key $key ...)" ;;
  esac
  f="$PDIR/candidates/$key.md"
  seen="$(fm_get "$f" seen)"
  is_uint "$seen" || die "candidate $key has invalid seen: '$seen' (run 'learn doctor')"
  day="${date:-$(today)}"
  local first last
  first="$(fm_get "$f" first-seen)"; last="$(fm_get "$f" last-seen)"
  # ISO dates order lexicographically: first-seen = min, last-seen = max.
  if ! valid_calendar_date "$first" || [[ "$day" < "$first" ]]; then first="$day"; fi
  if ! valid_calendar_date "$last" || [[ "$day" > "$last" ]]; then last="$day"; fi
  fm_set "$f" seen "$((seen + 1))"
  fm_set "$f" first-seen "$first"
  fm_set "$f" last-seen "$last"
  projects="$(fm_get "$f" projects)"
  if ! project_listed "$projects" "$project"; then
    projects="${projects#\[}"; projects="${projects%\]}"
    if [ -n "$projects" ]; then projects="$projects, $project"; else projects="$project"; fi
    fm_set "$f" projects "[$projects]"
  fi
  append_evidence "$f" "- $day $project: $evidence"
  write_index
  echo "bumped $key (seen: $((seen + 1)))"
  if [ -n "$from" ]; then draft_cleanup "$from"; fi
}

cmd_propose() {
  local key="" owner=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn propose <key> [--owner <o>]"; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] || die "usage: learn propose <key> [--owner <o>]"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  [ -f "$PDIR/candidates/$key.md" ] || die "no candidate '$key'"
  owner="$(oneline "$owner")"
  fm_set "$PDIR/candidates/$key.md" status proposed
  fm_set "$PDIR/candidates/$key.md" proposed-at "$(today)"
  if [ -n "$owner" ]; then fm_set "$PDIR/candidates/$key.md" suggested-owner "$owner"; fi
  write_index
  echo "proposed $key"
}

cmd_apply() {
  local key="" owner="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      --change-ref) [ $# -ge 2 ] || die "--change-ref requires a value"; ref="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn apply <key> --owner <o> --change-ref <r>"; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] && [ -n "$owner" ] && [ -n "$ref" ] || die "usage: learn apply <key> --owner <o> --change-ref <r>"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  owner="$(oneline "$owner")"
  valid_owner "$owner" || die "invalid owner '$owner': use script:<path> | skill:<name> | new-skill:<name> | agents:<repo> | config:<path> | hint:<id>"
  ref="$(oneline "$ref")"
  local existing
  existing="$(find_key "$key")"
  case "$existing" in
    candidates) ;;
    applied) die "'$key' is already applied" ;;
    rejected) die "'$key' was rejected; cannot apply" ;;
    *) die "no candidate '$key'" ;;
  esac
  local f="$PDIR/candidates/$key.md"
  fm_set "$f" owner "$owner"
  fm_set "$f" change-ref "$ref"
  fm_set "$f" applied-at "$(today)"
  fm_set "$f" status applied
  mv "$f" "$PDIR/applied/$key.md"
  write_index
  echo "applied $key -> $owner"
}

cmd_reject() {
  local key="" reason="" from=""
  local rejusage='usage: learn reject <key> --reason "..." | --from <file>'
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || die "--from requires a value"; from="$2"; shift 2 ;;
      --reason) [ $# -ge 2 ] || die "--reason requires a value"; reason="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "$rejusage"; key="$1"; shift ;;
    esac
  done
  if [ -n "$from" ]; then
    draft_load "$from"
    draft_fill "$from" key key; draft_fill "$from" reason reason
    key="$(oneline "$key")"
  fi
  [ -n "$key" ] && [ -n "$reason" ] || die "$rejusage"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  reason="$(oneline "$reason")"
  [ -n "$reason" ] || die "reason must not be empty"
  [ -f "$PDIR/candidates/$key.md" ] || die "no candidate '$key'"
  local f="$PDIR/candidates/$key.md"
  fm_set "$f" reason "$reason"
  fm_set "$f" status rejected
  mv "$f" "$PDIR/rejected/$key.md"
  write_index
  echo "rejected $key"
  if [ -n "$from" ]; then draft_cleanup "$from"; fi
}

cmd_prune() {
  local days=90 f key seen last status age now_days moved=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) [ $# -ge 2 ] || die "--days requires a value"; days="$2"; shift 2 ;;
      *) die "usage: learn prune [--days N]" ;;
    esac
  done
  is_uint "$days" || die "--days must be a non-negative integer"
  days=$((10#$days))
  resolve_profile
  now_days="$(days_from_civil "$(today)")"
  for f in "$PDIR"/candidates/*.md; do
    [ -e "$f" ] || continue
    key="$(basename "$f" .md)"
    seen="$(fm_get "$f" seen)"
    [ "$seen" = "1" ] || continue
    status="$(fm_get "$f" status)"
    [ "$status" = "candidate" ] || continue
    last="$(fm_get "$f" last-seen)"
    if ! valid_calendar_date "$last"; then warn "skipping $key: invalid last-seen '$last'"; continue; fi
    age=$((now_days - $(days_from_civil "$last")))
    if [ "$age" -gt "$days" ]; then
      fm_set "$f" reason stale
      fm_set "$f" status rejected
      mv "$f" "$PDIR/rejected/$key.md"
      echo "pruned $key (${age}d idle)"
      moved=$((moved + 1))
    fi
  done
  write_index
  echo "pruned $moved candidate(s)"

  # Acked inbox files: filename date older than (ack date - days) means every event is acked and stale.
  local ack ack_date ack_days fdate removed=0
  ack="$(read_ack)"
  ack_date="${ack:0:10}"
  if valid_calendar_date "$ack_date"; then
    ack_days="$(days_from_civil "$ack_date")"
    for f in "$PDIR"/inbox/*.jsonl; do
      [ -e "$f" ] || continue
      fdate="$(basename "$f" .jsonl)"
      fdate="${fdate%-backfill}"   # backfills are named by arrival date: <date>-backfill.jsonl
      valid_calendar_date "$fdate" || continue
      if [ "$(days_from_civil "$fdate")" -lt $((ack_days - days)) ]; then
        rm -f "$f"
        removed=$((removed + 1))
      fi
    done
  fi
  echo "removed $removed acked inbox file(s)"
}

# ---------------------------------------------------------------------------
# status / doctor / grep
# ---------------------------------------------------------------------------

count_md() {
  local n=0 f
  for f in "$1"/*.md; do
    [ -e "$f" ] || continue
    n=$((n + 1))
  done
  echo "$n"
}

cmd_status() {
  [ $# -eq 0 ] || die "usage: learn status"
  resolve_profile
  local unacked ack dirty top dpid
  ack="$(read_ack)"
  unacked="$(inbox_stream raw "" "$ack" "" "" | grep -c '' || true)"
  echo "store:      $STORE_HOME"
  echo "profile:    $PROFILE  -> $PDIR"
  echo "candidates: $(count_md "$PDIR/candidates")"
  echo "applied:    $(count_md "$PDIR/applied")"
  echo "rejected:   $(count_md "$PDIR/rejected")"
  echo "inbox:      $unacked unacked event(s)"
  if dpid="$(dream_lock_pid)"; then echo "dream:      running (pid $dpid)"; fi
  top="$(git -C "$STORE_HOME" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && top="$(cd -P "$top" && pwd -P)" && [ "$top" = "$STORE_HOME" ]; then
    dirty="$(git -C "$STORE_HOME" status --porcelain --untracked-files=all | wc -l | tr -d ' ')"
    if [ "$dirty" -eq 0 ]; then echo "git:        clean"; else echo "git:        $dirty uncommitted path(s) — run 'learn backup'"; fi
  else
    echo "git:        unavailable (store is not a git repository)"
  fi
}

DOC_PROBLEMS=0
dprob() { echo "$*"; DOC_PROBLEMS=$((DOC_PROBLEMS + 1)); }

doctor_dir_checks() {   # doctor_dir_checks <dirname>
  local d="$1" f base key v area desc n status p
  for f in "$PDIR/$d"/*.md; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    key="${base%.md}"
    p="$(entry_problems "$f")"
    if [ -n "$p" ]; then
      while IFS= read -r line; do dprob "$line"; done <<< "$p"
      continue
    fi
    desc="$(fm_get "$f" description)"
    n="$(char_len "$desc")"
    if [ "$n" -gt 120 ]; then dprob "LONG DESCRIPTION ($n chars > 120): $d/$base"; fi
    if ! valid_key "$key"; then
      dprob "BAD KEY (expected <area>.<symptom>): $d/$base"
    else
      area="${key%%.*}"
      in_list "$area" "$AREAS" || echo "warning: area '$area' not in vocabulary: $d/$base"
    fi
    status="$(fm_get "$f" status)"
    case "$d" in
      candidates)
        case "$status" in
          candidate|proposed|open-question) ;;
          *) dprob "BAD STATUS ('$status' in candidates/): $d/$base" ;;
        esac ;;
      applied)
        [ "$status" = "applied" ] || dprob "BAD STATUS ('$status' in applied/): $d/$base"
        for v in owner change-ref applied-at; do
          [ -n "$(fm_get "$f" "$v")" ] || dprob "APPLIED MISSING $v: $d/$base"
        done
        v="$(fm_get "$f" owner)"
        if [ -n "$v" ] && ! valid_owner "$v"; then dprob "BAD OWNER ('$v'; use script:|skill:|new-skill:|agents:|config:|hint:): $d/$base"; fi ;;
      rejected)
        [ "$status" = "rejected" ] || dprob "BAD STATUS ('$status' in rejected/): $d/$base"
        [ -n "$(fm_get "$f" reason)" ] || dprob "REJECTED MISSING reason: $d/$base" ;;
    esac
  done
}

doctor_profile_checks() {   # uses PDIR
  local d expected actual f
  for d in inbox candidates applied rejected; do
    [ -d "$PDIR/$d" ] || echo "warning: missing directory $d/ (created on first use)"
  done
  for d in candidates applied rejected; do doctor_dir_checks "$d"; done
  if [ ! -f "$PDIR/INDEX.md" ]; then
    dprob "MISSING INDEX: $PDIR/INDEX.md (run 'learn index')"
  else
    expected="$(render_index 2>/dev/null || true)"
    actual="$(<"$PDIR/INDEX.md")"
    [ "$expected" = "$actual" ] || dprob "INDEX DRIFT: INDEX.md differs from candidates/ (run 'learn index')"
  fi
  for f in "$PDIR"/applied/*.md; do
    [ -e "$f" ] || continue
    if [ -f "$PDIR/candidates/$(basename "$f")" ]; then
      dprob "DUPLICATE KEY (in candidates/ and applied/): $(basename "$f" .md)"
    fi
  done
}

cmd_doctor() {
  [ $# -eq 0 ] || die "usage: learn doctor"
  local target resolved
  DOC_PROBLEMS=0
  if [ -n "$PROFILE_OVERRIDE" ]; then
    # --profile <p>: check that profile directly (no ./.learnings needed).
    require_slug "profile name" "$PROFILE_OVERRIDE"
    if [ ! -d "$LEARN_HOME" ]; then dprob "STORE MISSING: $LEARN_HOME"; echo "problems: $DOC_PROBLEMS"; exit 1; fi
    load_store
    [ -d "$STORE_HOME/$PROFILE_OVERRIDE" ] || die "no such profile in the store: $PROFILE_OVERRIDE"
    PDIR="$(cd -P "$STORE_HOME/$PROFILE_OVERRIDE" && pwd -P)"
    PROFILE="$PROFILE_OVERRIDE"
    is_in_store "$PDIR" || dprob "UNSAFE PROFILE DIR: $PDIR (outside $STORE_HOME)"
    [ "$DOC_PROBLEMS" -gt 0 ] || doctor_profile_checks
    doctor_markers_check
    doctor_hints_check
    if [ "$DOC_PROBLEMS" -gt 0 ]; then die "problems found ($DOC_PROBLEMS)"; fi
    echo "OK"
    return 0
  fi
  if [ ! -e .learnings ] && [ ! -L .learnings ]; then
    die "no .learnings symlink here (ask the user to run: learn init <profile>)"
  fi
  if [ ! -d "$LEARN_HOME" ]; then dprob "STORE MISSING: $LEARN_HOME"; echo "problems: $DOC_PROBLEMS"; exit 1; fi
  load_store
  if [ ! -L .learnings ]; then
    dprob "NOT A SYMLINK: .learnings"
  else
    target="$(readlink .learnings)"
    case "$target" in
      /*) ;;
      *) dprob "UNSAFE SYMLINK: .learnings -> $target (relative target)" ;;
    esac
    if [ ! -d .learnings ]; then
      dprob "BROKEN: .learnings -> $target"
    else
      resolved="$(cd -P .learnings && pwd -P)"
      if ! is_in_store "$resolved"; then
        dprob "UNSAFE SYMLINK: .learnings -> $target (outside $STORE_HOME)"
      else
        PDIR="$resolved"
        PROFILE="$(basename "$target")"
        doctor_profile_checks
      fi
    fi
  fi
  doctor_markers_check
  doctor_hints_check
  if [ "$DOC_PROBLEMS" -gt 0 ]; then die "problems found ($DOC_PROBLEMS)"; fi
  echo "OK"
}

doctor_markers_check() {
  if [ -f "$STORE_HOME/markers.json" ]; then
    local merrs line
    if ! merrs="$(validate_markers_file "$STORE_HOME/markers.json")"; then
      while IFS= read -r line; do dprob "BAD MARKERS: $line"; done <<< "$merrs"
    fi
  else
    echo "warning: $STORE_HOME/markers.json missing (run 'learn init <profile>')"
  fi
}

# Personal hints are optional: only validate the file when it exists.
doctor_hints_check() {
  [ -f "$STORE_HOME/hints.json" ] || return 0
  local herrs line
  if ! herrs="$(validate_markers_file "$STORE_HOME/hints.json" validateHints hints)"; then
    while IFS= read -r line; do dprob "BAD HINTS: $line"; done <<< "$herrs"
  fi
}

cmd_grep() {
  [ $# -ge 1 ] || die "usage: learn grep <pattern> [extra grep options]"
  resolve_profile
  local pattern="$1" rc=0
  shift
  (cd "$PDIR" && grep -r -n -i "$@" -- "$pattern" candidates applied rejected) || rc=$?
  case "$rc" in
    0) ;;
    1) echo "no matches for '$pattern'" ;;
    *) die "grep failed (exit $rc)" ;;
  esac
}

# ---------------------------------------------------------------------------
# markers
# ---------------------------------------------------------------------------

# Validate a markers JSON file via learn-core.js validateMarkers(json) (array of
# error strings, empty = ok). Errors go to stdout, one per line; returns 1 if any.
# Without node, learn-core.js, or the export: JSON-syntax check only (with a warning).
validate_markers_file() {   # validate_markers_file <file> [validator] [label]
  local out rc=0 fn="${2:-validateMarkers}" label="${3:-markers}"
  if ! command -v node >/dev/null 2>&1; then
    warn "warning: node not found; $label not validated"
    return 0
  fi
  out="$(L_FILE="$1" L_FN="$fn" L_CORE="$OPENCODE_DIR/learn-core.js" node -e '
    const fs = require("fs");
    const { pathToFileURL } = require("url");
    let j;
    try { j = JSON.parse(fs.readFileSync(process.env.L_FILE, "utf8")); }
    catch (e) { console.log("not valid JSON: " + e.message); process.exit(1); }
    import(pathToFileURL(process.env.L_CORE).href).then((m) => {
      const fn = process.env.L_FN;
      if (typeof m[fn] !== "function") {
        console.error("learn: warning: " + fn + " unavailable in learn-core.js; only JSON syntax checked");
        return;
      }
      const errs = m[fn](j) || [];
      if (errs.length) { for (const e of errs) console.log(e); process.exit(1); }
    }).catch((e) => {
      console.error("learn: warning: cannot load learn-core.js (" + (e && e.message ? e.message : e) + "); only JSON syntax checked");
    });
  ')" || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ -n "$out" ] || out="$label validation failed (exit $rc)"
    printf '%s\n' "$out"
    return 1
  fi
  return 0
}

cmd_markers() {
  local sub="${1:-}"
  [ $# -eq 0 ] || shift
  local default_file="$OPENCODE_DIR/markers.default.json"
  local personal_file
  load_store
  personal_file="$STORE_HOME/markers.json"
  case "$sub" in
    list)
      [ $# -eq 0 ] || die "usage: learn markers list"
      command -v node >/dev/null 2>&1 || die "node is required for 'markers list'"
      L_DEFAULT="$default_file" L_PERSONAL="$personal_file" node -e '
        const fs = require("fs");
        const rd = (p) => { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch (e) { if (e.code === "ENOENT") return null; throw e; } };
        const d = rd(process.env.L_DEFAULT), p = rd(process.env.L_PERSONAL);
        const groups = [
          ["correction/strong", (x) => x && x.correction && x.correction.strong],
          ["correction/medium", (x) => x && x.correction && x.correction.medium],
          ["correction/weak", (x) => x && x.correction && x.correction.weak],
          ["confirmation", (x) => x && x.confirmation],
        ];
        for (const [name, get] of groups) {
          console.log(name + ":");
          for (const [label, x] of [["default", d], ["personal", p]])
            for (const m of (get(x) || [])) console.log("  [" + label + "] " + m);
        }
      ' || die "cannot read markers (invalid JSON?)"
      ;;
    add)
      local tier="" re=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --tier) [ $# -ge 2 ] || die "--tier requires a value"; tier="$2"; shift 2 ;;
          -*) die "unknown option: $1" ;;
          *) [ -z "$re" ] || die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\""; re="$1"; shift ;;
        esac
      done
      case "$tier" in strong|medium|weak|confirmation) ;; *) die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\"" ;; esac
      [ -n "$re" ] || die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\""
      command -v node >/dev/null 2>&1 || die "node is required for 'markers add'"
      local mtmp="$personal_file.tmp.$$" merrs
      rm -f "$mtmp"
      L_FILE="$personal_file" L_TMP="$mtmp" L_TIER="$tier" L_RE="$re" node -e '
        const fs = require("fs");
        const f = process.env.L_FILE, t = process.env.L_TIER, re = process.env.L_RE;
        let j;
        try { j = JSON.parse(fs.readFileSync(f, "utf8")); }
        catch (e) {
          if (e.code !== "ENOENT") { console.error("markers.json is not valid JSON: " + e.message); process.exit(3); }
          j = { version: 1, correction: { strong: [], medium: [], weak: [] }, confirmation: [] };
        }
        j.version = j.version || 1;
        j.correction = j.correction || {};
        let arr;
        if (t === "confirmation") arr = (j.confirmation = j.confirmation || []);
        else arr = (j.correction[t] = j.correction[t] || []);
        if (arr.includes(re)) { console.log("already present in " + t); process.exit(0); }
        arr.push(re);
        fs.writeFileSync(process.env.L_TMP, JSON.stringify(j, null, 2) + "\n");
      ' || { rm -f "$mtmp"; die "could not add marker"; }
      if [ -f "$mtmp" ]; then
        if ! merrs="$(validate_markers_file "$mtmp")"; then
          rm -f "$mtmp"
          die "could not add marker: $merrs"
        fi
        mv "$mtmp" "$personal_file"
        echo "added to $tier: $re"
      fi
      ;;
    test)
      [ $# -eq 1 ] || die "usage: learn markers test \"<text>\""
      command -v node >/dev/null 2>&1 || die "node is required for 'markers test'"
      [ -f "$OPENCODE_DIR/learn-core.js" ] || die "learn-core.js not found at $OPENCODE_DIR"
      L_CORE="$OPENCODE_DIR/learn-core.js" L_DEFAULT="$default_file" L_PERSONAL="$personal_file" L_TEXT="$1" node -e '
        const { pathToFileURL } = require("url");
        import(pathToFileURL(process.env.L_CORE).href).then(async (m) => {
          const markers = await m.loadMarkers(process.env.L_DEFAULT, process.env.L_PERSONAL);
          const r = await m.matchMarkers(process.env.L_TEXT, markers);
          if (!r) { console.log("no match"); return; }
          const src = r.marker && r.marker.source ? r.marker.source : String(r.marker);
          console.log((r.tier || r.role) + "\t" + src);
        }).catch((e) => { console.error(e && e.message ? e.message : String(e)); process.exit(1); });
      ' || die "markers test failed"
      ;;
    *) die "usage: learn markers list | add --tier <t> \"<re>\" | test \"<text>\"" ;;
  esac
}

# ---------------------------------------------------------------------------
# dream
#
# `learn dream --report` is a read-only analysis of the whole store (all
# profiles); `learn dream` hands it to a sandboxed OpenCode agent that triages
# the inbox, merges duplicate candidates and prepares proposals, then rebuilds
# the indexes and commits. The agent never applies anything.
# ---------------------------------------------------------------------------

# Profiles of the store (one per line), optionally only $1: valid-slug
# directories that hold inbox/candidates/applied/rejected. Dot entries and
# anything whose canonical path leaves the store are skipped.
dream_profiles() {
  local only="${1:-}" d name canon
  for d in "$STORE_HOME"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    name="${d##*/}"
    valid_slug "$name" || continue
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    [ -d "$d/inbox" ] || [ -d "$d/candidates" ] || [ -d "$d/applied" ] || [ -d "$d/rejected" ] || continue
    canon="$(cd -P "$d" 2>/dev/null && pwd -P)" || continue
    is_in_store "$canon" || continue
    printf '%s\n' "$name"
  done
}

# Similar-candidate analysis. Reads sorted rows  profile<TAB>key<TAB>text  where
# text is the key's symptom plus the description, and prints report lines.
# Tokens are lowercased words; anything that is not [a-z0-9] or a byte >= 0x80
# separates words (so Cyrillic words stay whole); words under 3 characters and
# DREAM_STOPWORDS are dropped and duplicates collapse. A pair is reported when
# it shares >= 2 words and |shared| / min(|A|,|B|) >= 0.6. Candidates of
# different profiles are never compared.
dream_pairs() {
  LC_ALL=C awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["DREAM_STOPWORDS"], stopArr, " ")
      for (i = 1; i <= n; i++) STOP[stopArr[i]] = 1
    }
    function tokenize(id, text,   s, arr, nn, i, w, nw, seen, tmp, hi, clen) {
      s = tolower(text)
      gsub(/[^a-z0-9\200-\377]+/, " ", s)
      nn = split(s, arr, " ")
      nw = 0
      for (i = 1; i <= nn; i++) {
        w = arr[i]
        tmp = w
        hi = gsub(/[\200-\277]/, "", tmp)
        clen = length(w) - hi
        if (clen < 3) continue
        if (w in STOP) continue
        if (w in seen) continue
        seen[w] = 1
        WORD[id, ++nw] = w
      }
      return nw
    }
    {
      N++
      PROF[N] = $1; KEY[N] = $2
      NW[N] = tokenize(N, $3)
    }
    END {
      for (a = 1; a <= N; a++) {
        for (b = a + 1; b <= N; b++) {
          if (PROF[b] != PROF[a]) continue
          shared = 0
          delete SW
          for (x = 1; x <= NW[a]; x++) {
            wa = WORD[a, x]
            for (y = 1; y <= NW[b]; y++) {
              if (wa == WORD[b, y]) { if (!(wa in SW)) { SW[wa] = 1; shared++ }; break }
            }
          }
          minlen = (NW[a] < NW[b]) ? NW[a] : NW[b]
          if (!(shared >= 2 && minlen > 0 && (shared / minlen) >= 0.6)) continue
          ns = 0
          for (k in SW) sw2[++ns] = k
          for (ii = 2; ii <= ns; ii++) {
            tmp = sw2[ii]; jj = ii - 1
            while (jj >= 1 && sw2[jj] > tmp) { sw2[jj + 1] = sw2[jj]; jj-- }
            sw2[jj + 1] = tmp
          }
          list = "shared: " sw2[1]
          for (ii = 2; ii <= ns; ii++) list = list ", " sw2[ii]
          delete sw2
          print "  [" PROF[a] "] candidates/" KEY[a] ".md <-> candidates/" KEY[b] ".md (" list ")"
        }
      }
    }
  '
}

# Number of lines in $1 (0 when empty).
dream_count() {
  if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | grep -c '' || true; fi
}

# One report section: header plus the sorted body; nothing when body is empty.
dream_emit() {   # dream_emit <header> <body>
  [ -n "$2" ] || return 0
  echo "$1"
  printf '%s\n' "$2" | LC_ALL=C sort
}

# Accumulators filled by dream_scan_profile (one line per item, no trailing nl).
D_UNACKED="" D_UNACKED_N=0 D_ROWS="" D_READY="" D_PROPOSED="" D_STALE="" D_UNUSABLE="" D_HYGIENE=""

dream_add() {   # dream_add <var> <line>
  local cur="${!1}"
  if [ -n "$cur" ]; then printf -v "$1" '%s\n%s' "$cur" "$2"; else printf -v "$1" '%s' "$2"; fi
}

# Scan one profile read-only: sets PROFILE/PDIR and appends to the D_* vars.
dream_scan_profile() {   # dream_scan_profile <profile> <stale-days> <today-days>
  local prof="$1" stale_days="$2" today_days="$3"
  local tag="[$1]" tab=$'\t' d f base key probs reason line desc n seen status last since
  local projects plist np age area sym ack out cnt oldest newest tss expected actual owner
  PROFILE="$prof"
  PDIR="$(cd -P "$STORE_HOME/$prof" && pwd -P)"

  ack="$(read_ack)"
  out="$(inbox_stream compact "" "$ack" "" "" "" 1)"
  if [ -n "$out" ]; then
    # Unacked count uses the arrival key; oldest/newest show event time (ts).
    cnt="$(printf '%s\n' "$out" | grep -c '')"
    tss="$(printf '%s\n' "$out" | cut -f2- | awk '{ print $1 }' | LC_ALL=C sort)"
    oldest="$(printf '%s\n' "$tss" | sed -n '1p')"
    newest="$(printf '%s\n' "$tss" | tail -n 1)"
    D_UNACKED_N=$((D_UNACKED_N + cnt))
    dream_add D_UNACKED "  $tag $cnt event(s), oldest $oldest, newest $newest"
  fi

  for d in candidates applied rejected; do
    for f in "$PDIR/$d"/*.md; do
      [ -e "$f" ] || continue
      base="${f##*/}"
      key="${base%.md}"
      probs="$(entry_problems "$f")"
      if [ -n "$probs" ]; then
        reason="$(printf '%s\n' "$probs" | while IFS= read -r line; do printf '%s; ' "${line%": $f"}"; done)"
        dream_add D_UNUSABLE "  $tag $d/$base — ${reason%; }"
        continue
      fi
      desc="$(fm_get "$f" description)"
      n="$(char_len "$desc")"
      if [ "$n" -gt 120 ]; then dream_add D_HYGIENE "  $tag long description ($n chars): $d/$base"; fi
      if valid_key "$key"; then
        area="${key%%.*}"
        if ! in_list "$area" "$AREAS"; then dream_add D_HYGIENE "  $tag unknown area '$area': $d/$base"; fi
      else
        dream_add D_HYGIENE "  $tag bad key (expected <area>.<symptom>): $d/$base"
      fi
      if [ "$d" = applied ]; then
        owner="$(fm_get "$f" owner)"
        if [ -z "$owner" ]; then dream_add D_HYGIENE "  $tag applied without owner: $d/$base"; fi
      fi
      [ "$d" = candidates ] || continue

      if [ -f "$PDIR/INDEX.md" ] && ! grep -qF "](candidates/$base)" "$PDIR/INDEX.md"; then
        dream_add D_UNUSABLE "  $tag $d/$base — not in INDEX.md"
      fi
      sym="${key#*.}"
      D_ROWS="$D_ROWS$prof$tab$key$tab$(oneline "$sym $desc")"$'\n'

      seen="$(fm_get "$f" seen)"
      seen=$((10#$seen))
      status="$(fm_get "$f" status)"
      last="$(fm_get "$f" last-seen)"
      projects="$(fm_get "$f" projects)"
      plist="${projects#\[}"; plist="${plist%\]}"
      np="$(printf '%s' "$plist" | tr ',' '\n' | awk 'NF { c++ } END { print c + 0 }')"
      case "$status" in
        candidate)
          if { [ "$seen" -ge 3 ] || { [ "$seen" -ge 2 ] && [ "$np" -ge 2 ]; }; } \
             && ! grep -q '^## Proposal' "$f"; then
            owner="$(fm_get "$f" suggested-owner)"
            line="  $tag $key — seen $seen, projects: ${plist:-none}"
            if [ -n "$owner" ]; then line="$line, suggested-owner: $owner"; fi
            dream_add D_READY "$line"
          fi
          if [ "$seen" -eq 1 ]; then
            age=$((today_days - $(days_from_civil "$last")))
            if [ "$age" -gt "$stale_days" ]; then
              dream_add D_STALE "  $tag $key — seen 1, last-seen $last (${age}d idle)"
            fi
          fi ;;
        proposed)
          since="$(fm_get "$f" proposed-at)"
          valid_calendar_date "$since" || since="$last"
          age=$((today_days - $(days_from_civil "$since")))
          if [ "$age" -gt 14 ]; then
            dream_add D_PROPOSED "  $tag $key — proposed $since (${age}d ago), waiting for a user decision"
          fi ;;
      esac
    done
  done

  if [ -f "$PDIR/INDEX.md" ]; then
    expected="$(render_index 2>/dev/null || true)"
    actual="$(<"$PDIR/INDEX.md")"
    if [ "$expected" != "$actual" ]; then dream_add D_UNUSABLE "  $tag INDEX.md — index drift (differs from candidates/)"; fi
  else
    dream_add D_UNUSABLE "  $tag INDEX.md — missing"
  fi
}

dream_report() {   # dream_report <stale-days> [<profile>]
  local stale_days="$1" only="${2:-}" day today_days prof profs
  load_store
  day="$(today)"
  today_days="$(days_from_civil "$day")"
  D_UNACKED="" D_UNACKED_N=0 D_ROWS="" D_READY="" D_PROPOSED="" D_STALE="" D_UNUSABLE="" D_HYGIENE=""
  profs="$(dream_profiles "$only")"
  if [ -n "$only" ] && [ -z "$profs" ]; then die "no such profile in the store: $only"; fi
  while IFS= read -r prof; do
    [ -n "$prof" ] || continue
    dream_scan_profile "$prof" "$stale_days" "$today_days"
  done <<< "$profs"

  local similar=""
  if [ -n "$D_ROWS" ]; then
    similar="$(printf '%s' "$D_ROWS" | LC_ALL=C sort | dream_pairs)"
  fi

  dream_emit "unacked inbox (triage, then 'learn ack --profile <p> --until <ts>'):" "$D_UNACKED"
  dream_emit "similar candidates (merge, or confirm they differ):" "$similar"
  dream_emit "ready for proposal (threshold met, no ## Proposal section):" "$D_READY"
  dream_emit "proposed without decision (older than 14 days — needs the user):" "$D_PROPOSED"
  dream_emit "stale (seen 1, older than $stale_days days — reject or keep):" "$D_STALE"
  dream_emit "unusable (fix frontmatter / run 'learn index'):" "$D_UNUSABLE"
  dream_emit "hygiene:" "$D_HYGIENE"

  local a c e f g h
  a="$D_UNACKED_N"
  c="$(dream_count "$similar")"
  e="$(dream_count "$D_READY")"
  f="$(dream_count "$D_STALE")"
  g="$(dream_count "$D_UNUSABLE")"
  h=$(( $(dream_count "$D_PROPOSED") + $(dream_count "$D_HYGIENE") ))
  if [ $((a + c + e + f + g + h)) -eq 0 ]; then
    echo "dream: learnings are tidy — nothing to consolidate"
  else
    echo "dream: $a unacked, $c similar, $e ready, $f stale, $g unusable"
  fi
}

# Replace every __NAME__ placeholder of a template. Placeholder values were
# checked for JSON-unsafe characters by the caller. Plain literal replacement
# in awk: bash's ${text//pat/rep} is quadratic on bash 3.2 (macOS) in a UTF-8
# locale (a 40 KB config took over a minute), and '&' in a value would be
# special with patsub_replacement (bash 5.2+).
dream_render() {   # dream_render <template> <store> <learn-bin> <home>
  printf '%s\n' "$1" | R_STORE="$2" R_BIN="$3" R_HOME="$4" LC_ALL=C awk '
    function rep(s, from, to,   out, i) {
      out = ""
      while ((i = index(s, from)) > 0) {
        out = out substr(s, 1, i - 1) to
        s = substr(s, i + length(from))
      }
      return out s
    }
    {
      $0 = rep($0, "__STORE__", ENVIRON["R_STORE"])
      $0 = rep($0, "__LEARN_BIN__", ENVIRON["R_BIN"])
      $0 = rep($0, "__HOME__", ENVIRON["R_HOME"])
      print
    }
  '
}

# Keep local bookkeeping out of the store's commits via .git/info/exclude.
ensure_store_excludes() {
  local p ex="$STORE_HOME/.git/info/exclude"
  mkdir -p "$STORE_HOME/.git/info"
  for p in /.dream-last /.drafts/ /.dream.lock '.learn.*'; do
    if ! grep -qxF "$p" "$ex" 2>/dev/null; then
      if [ -s "$ex" ] && [ -n "$(tail -c 1 "$ex")" ]; then printf '\n' >> "$ex"; fi
      printf '%s\n' "$p" >> "$ex"
    fi
  done
}

# Dream lock: $STORE_HOME/.dream.lock holds the PID of the running `learn dream`.
# The plugin spawns `learn backup` after every turn; backup skips while the lock
# is live so it cannot commit half-finished dream work or fight over index.lock.

# Echo the PID and return 0 when the lock is held by a live process; else return 1.
dream_lock_pid() {
  local pid=""
  IFS= read -r pid 2>/dev/null < "$STORE_HOME/.dream.lock" || true
  is_uint "$pid" && [ "$pid" -gt 0 ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

# Remove the lock, but only when it still holds our PID.
dream_lock_release() {
  local pid=""
  IFS= read -r pid 2>/dev/null < "$STORE_HOME/.dream.lock" || true
  if [ "$pid" = "$$" ]; then rm -f "$STORE_HOME/.dream.lock"; fi
  return 0
}

# Take the lock atomically (noclobber); replace a stale or unreadable one; die
# when a live dream holds it. Releases on every exit path.
dream_lock_acquire() {
  local lock="$STORE_HOME/.dream.lock" pid tries=0
  while :; do
    if ( set -o noclobber; printf '%s\n' "$$" > "$lock" ) 2>/dev/null; then break; fi
    if pid="$(dream_lock_pid)"; then die "another learn dream is running (pid $pid)"; fi
    tries=$((tries + 1))
    [ "$tries" -le 5 ] || die "cannot take the dream lock $lock"
    rm -f "$lock"   # stale or unreadable
  done
  trap dream_lock_release EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  trap 'exit 129' HUP
}

# Stage everything and commit; returns 1 when there was nothing to commit.
dream_commit() {   # dream_commit <message>
  # die, not return: callers test this function in `if`, where a failed add
  # (e.g. index.lock) would otherwise read as "no changes".
  git -C "$STORE_HOME" add -A || die "git add failed in $STORE_HOME"
  if git -C "$STORE_HOME" diff --cached --quiet 2>/dev/null \
     && git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    return 1
  fi
  git -C "$STORE_HOME" commit -q -m "$1" \
    || die "commit failed in $STORE_HOME — is git user.name / user.email configured?"
}

# Last non-empty line of the agent's output, if it looks like the requested
# summary ("summary: triaged …" / "triaged …"); empty otherwise.
dream_summary_line() {   # dream_summary_line <output-file>
  local line lower
  line="$(LC_ALL=C sed $'s/\x1b\\[[0-9;]*[A-Za-z]//g' "$1" | awk 'NF { l = $0 } END { print l }')"
  line="$(oneline "$line")"
  lower="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    "summary:"*) line="${line#*:}" ;;
    "dream:"*) line="${line#*:}" ;;
    "triaged "*) ;;
    *) return 0 ;;
  esac
  line="$(oneline "$line")"
  printf '%s' "${line:0:120}"
}

cmd_dream() {
  local usage="usage: learn dream [--report [--stale-days N]] [--profile <p>] [--model <provider/model>] [--if-changed] [--print-config]"
  # AGENT_LEARNINGS_DREAM_MODEL sets the default model; --model overrides it.
  local report=0 stale_days="" profile="" model="${AGENT_LEARNINGS_DREAM_MODEL:-}" print_config=0 model_flag=0 if_changed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --report) report=1; shift ;;
      --print-config) print_config=1; shift ;;
      --if-changed) if_changed=1; shift ;;
      --stale-days)
        [ $# -ge 2 ] || die "$usage"
        case "$2" in ''|*[!0-9]*) die "$usage" ;; esac
        [ "$((10#$2))" -gt 0 ] || die "$usage"
        stale_days="$((10#$2))"; shift 2 ;;
      --profile)
        [ $# -ge 2 ] || die "$usage"
        profile="$2"; shift 2 ;;
      --model)
        [ $# -ge 2 ] && [ -n "$2" ] || die "$usage"
        model="$2"; model_flag=1; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  if [ "$report" -eq 1 ]; then
    { [ "$model_flag" -eq 0 ] && [ "$print_config" -eq 0 ] && [ "$if_changed" -eq 0 ]; } || die "$usage"
  else
    [ -z "$stale_days" ] || die "$usage"
  fi
  [ -n "$stale_days" ] || stale_days=90

  load_store
  if [ -n "$profile" ]; then
    require_slug "profile name" "$profile"
    [ -d "$STORE_HOME/$profile" ] || die "no such profile in the store: $profile"
  fi

  if [ "$report" -eq 1 ]; then
    dream_report "$stale_days" "$profile"
    return 0
  fi

  local assets config prompt nlchar=$'\n' bs=$'\\' quote='"' bad
  assets="$SKILL_DIR/dream"
  [ -f "$assets/opencode.json" ] && [ -f "$assets/prompt.md" ] || die "dream assets not found in $assets"
  for bad in "$STORE_HOME" "$HOME" "$SCRIPT_PATH"; do
    case "$bad" in
      *"$quote"*|*"$bs"*|*"$nlchar"*) die "cannot run dream: path contains a quote, backslash or newline: $bad" ;;
      *[\*\?\[\]\{\}]*) die "cannot run dream: path contains a glob character (* ? [ ] { }): $bad" ;;
    esac
  done
  config="$(<"$assets/opencode.json")"
  prompt="$(<"$assets/prompt.md")"
  config="$(dream_render "$config" "$STORE_HOME" "$SCRIPT_PATH" "$HOME")"
  prompt="$(dream_render "$prompt" "$STORE_HOME" "$SCRIPT_PATH" "$HOME")"
  [ -z "$profile" ] || prompt="$prompt${nlchar}${nlchar}Profile scope: $profile (pass --profile $profile to every learn command)"

  if [ "$print_config" -eq 1 ]; then
    printf '%s\n' "$config"
    return 0
  fi

  [ -d "$STORE_HOME/.git" ] || die "store at $STORE_HOME is not a git repository (ask the user to run: learn init <profile>)"
  command -v opencode >/dev/null 2>&1 || die "opencode not found on PATH"

  # .dream-last and .drafts/ are local bookkeeping: keep them out of the store's commits.
  ensure_store_excludes
  # One dream at a time; `learn backup` skips while the lock is live.
  dream_lock_acquire
  # Commit pending changes first so the dream result is its own revertable commit.
  if [ -n "$(git -C "$STORE_HOME" status --porcelain --untracked-files=all)" ]; then
    dream_commit "learn: pre-dream snapshot" || true
    echo "dream: committed pending store changes first"
  fi
  local pre="" last=""
  pre="$(git -C "$STORE_HOME" rev-parse -q --verify HEAD 2>/dev/null || true)"

  # --if-changed: skip when no commit touched candidates/inbox/applied/rejected
  # since the sha stored in .dream-last, so a nightly job costs nothing on quiet days.
  if [ "$if_changed" -eq 1 ] && [ -n "$pre" ] && [ -f "$STORE_HOME/.dream-last" ]; then
    IFS= read -r last < "$STORE_HOME/.dream-last" || true
    if [ -n "$last" ] && git -C "$STORE_HOME" cat-file -e "$last^{commit}" 2>/dev/null \
       && [ -z "$(git -C "$STORE_HOME" diff --name-only "$last" "$pre" -- '*/candidates/*' '*/inbox/*' '*/applied/*' '*/rejected/*')" ]; then
      echo "dream: nothing changed in candidates/inbox/applied/rejected since the last run — skipping"
      dream_lock_release
      return 0
    fi
  fi

  # AGENT_LEARNINGS_HOME is pinned so the agent's `learn` calls see this store
  # even when the caller passed a relative path.
  local outfile rc=0
  # The agent writes free text to .drafts/draft.md; do not rely on its write tool creating the dir.
  mkdir -p "$STORE_HOME/.drafts"
  # The unattended session lives in its own OpenCode database (inside .git: never
  # committed), so it never shows up in the user's OpenCode session list. It holds
  # the latest run only.
  local db="$STORE_HOME/.git/learn-dream.db"
  rm -f "$db" "$db-wal" "$db-shm"
  outfile="$(mktemp "${TMPDIR:-/tmp}/learn-dream.XXXXXX")" || die "cannot create temporary file"
  set +e
  (cd "$STORE_HOME" && LEARN_DREAM=1 AGENT_LEARNINGS_HOME="$STORE_HOME" OPENCODE_CONFIG_CONTENT="$config" OPENCODE_DB="$db" \
    opencode run --standalone --agent learn-dream \
    ${model:+--model "$model"} "$prompt") | tee "$outfile"
  rc=${PIPESTATUS[0]}
  set -e
  if [ "$rc" -ne 0 ]; then
    rm -f "$outfile"
    die "opencode run failed (exit $rc); store changes, if any, are left uncommitted for review"
  fi

  echo "dream: session transcript in $db (latest run only)"
  local summary p
  summary="$(dream_summary_line "$outfile")"
  rm -f "$outfile"
  # Leftover drafts (agent scratch files) never outlive the run.
  if [ -d "$STORE_HOME/.drafts" ]; then
    find "$STORE_HOME/.drafts" -mindepth 1 -delete 2>/dev/null || true
  fi
  [ -n "$summary" ] || summary="consolidated"

  # Rebuild every profile's INDEX.md before the final commit.
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    PROFILE_OVERRIDE="$p"
    resolve_profile
    write_index
  done <<< "$(dream_profiles "")"
  PROFILE_OVERRIDE=""

  # Inbox events the plugin appended during the run get their own commit, so the
  # dream commit holds only the agent's changes, .ack and INDEX. The pathspec
  # form leaves anything the agent staged elsewhere (git rm / git mv) alone.
  if git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1 \
     && [ -n "$(git -C "$STORE_HOME" status --porcelain --untracked-files=all -- '*/inbox/*.jsonl')" ]; then
    git -C "$STORE_HOME" add -A -- '*/inbox/*.jsonl' || die "git add failed in $STORE_HOME"
    if ! git -C "$STORE_HOME" diff --cached --quiet -- '*/inbox/*.jsonl'; then
      git -C "$STORE_HOME" commit -q -m "learn: inbox events recorded during dream" -- '*/inbox/*.jsonl' \
        || die "commit failed in $STORE_HOME — is git user.name / user.email configured?"
    fi
  fi

  local committed=0
  if dream_commit "learn: dream — $summary"; then committed=1; fi
  if git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    git -C "$STORE_HOME" rev-parse HEAD > "$STORE_HOME/.dream-last"
  fi

  if [ "$committed" -eq 1 ]; then
    echo "dream: committed — $summary"
    echo "undo: git -C $STORE_HOME revert HEAD"
  else
    echo "dream: no changes"
  fi
}

# ---------------------------------------------------------------------------
# backup / install
# ---------------------------------------------------------------------------

# Counts from the staged diff: "added bumped applied rejected".
backup_counts() {
  git -C "$STORE_HOME" diff --cached --name-status -M | awk -F'\t' '
    {
      c = substr($1, 1, 1); p = $NF
      if (p ~ /^[^\/]+\/candidates\/[^\/]+\.md$/) {
        if (c == "A") add++
        else if (c == "M") bump++
      } else if (p ~ /^[^\/]+\/applied\/[^\/]+\.md$/) {
        if (c == "A" || c == "R") applied++
      } else if (p ~ /^[^\/]+\/rejected\/[^\/]+\.md$/) {
        if (c == "A" || c == "R") rej++
      }
    }
    END { printf "%d %d %d %d\n", add, bump, applied, rej }
  '
}

cmd_backup() {
  local push=0 profile="" target counts add bump applied rej msg subject dpid
  case "$#" in 0) ;; 1) [ "$1" = "--push" ] || die "usage: learn backup [--push]"; push=1 ;; *) die "usage: learn backup [--push]" ;; esac
  [ -d "$LEARN_HOME/.git" ] || die "no store at $LEARN_HOME (ask the user to run: learn init <profile>)"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
  # A running dream owns the store: no git operations, no push.
  if dpid="$(dream_lock_pid)"; then
    echo "dream in progress (pid $dpid) — backup skipped"
    return 0
  fi
  if [ -L .learnings ]; then
    target="$(readlink .learnings)"
    profile="$(basename "$target")"
  fi
  git -C "$STORE_HOME" add -A
  if git -C "$STORE_HOME" diff --cached --quiet 2>/dev/null && git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    echo "nothing to back up"
  else
    counts="$(backup_counts)"
    read -r add bump applied rej <<< "$counts"
    if [ -n "$profile" ]; then subject="learn($profile): "; else subject="learn: "; fi
    if [ "$add" -eq 0 ] && [ "$bump" -eq 0 ] && [ "$applied" -eq 0 ] && [ "$rej" -eq 0 ]; then
      msg="${subject}inbox update"
    else
      msg="${subject}+$add candidates, ~$bump bumped, →$applied applied"
      if [ "$rej" -gt 0 ]; then msg="$msg, -$rej rejected"; fi
    fi
    git -C "$STORE_HOME" commit -q -m "$msg" \
      || die "commit failed in $STORE_HOME — is git user.name / user.email configured?"
    echo "backed up: $msg"
  fi
  if [ "$push" -eq 1 ]; then
    git -C "$STORE_HOME" remote get-url origin >/dev/null 2>&1 || die "no remote configured (git -C $STORE_HOME remote add origin <url>)"
    git -C "$STORE_HOME" push -q origin HEAD
  fi
}

cmd_install_opencode() {
  [ $# -eq 0 ] || die "usage: learn install-opencode"
  local source config_dir destination current
  source="$OPENCODE_DIR/self-improving.js"
  [ -f "$source" ] || die "OpenCode plugin not found at $source"
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins"
  destination="$config_dir/self-improving.js"
  mkdir -p "$config_dir"
  if [ -L "$destination" ]; then
    current="$(canonical_path "$destination" 2>/dev/null)" || current=""   # dangling link: replace it
    if [ "$current" = "$source" ]; then echo "OpenCode plugin already installed: $destination"; return 0; fi
    rm "$destination"
  elif [ -e "$destination" ]; then
    die "refusing to overwrite non-symlink: $destination"
  fi
  ln -sfn "$source" "$destination"
  echo "installed OpenCode plugin: $destination (restart OpenCode to load it)"
}

main() {
  local cmd="${1:-}"
  if [ $# -gt 0 ]; then shift; fi
  # `--profile <p>` as the first argument addresses a store profile directly
  # (the dream agent runs in the store root, where there is no ./.learnings).
  # Leading `--profile <p> <cmd>` / `--profile=<p> <cmd>` is also accepted.
  case "$cmd" in
    --profile=*) PROFILE_OVERRIDE="${cmd#--profile=}"; [ -n "$PROFILE_OVERRIDE" ] || die "--profile requires a value"
      cmd="${1:-}"; if [ $# -gt 0 ]; then shift; fi ;;
    --profile)
      [ $# -ge 2 ] && [ -n "$1" ] || die "--profile requires a value"
      PROFILE_OVERRIDE="$1"; shift; cmd="${1:-}"; if [ $# -gt 0 ]; then shift; fi ;;
  esac
  case "$cmd" in
    inbox|ack|add|bump|propose|apply|reject|index|status|doctor|grep|prune)
      if [ "${1:-}" = "--profile" ]; then
        [ $# -ge 2 ] && [ -n "$2" ] || die "--profile requires a value"
        PROFILE_OVERRIDE="$2"
        shift 2
      fi ;;
  esac
  case "$cmd" in
    init) cmd_init "$@" ;; inbox) cmd_inbox "$@" ;; ack) cmd_ack "$@" ;;
    add) cmd_add "$@" ;; bump) cmd_bump "$@" ;; propose) cmd_propose "$@" ;;
    apply) cmd_apply "$@" ;; reject) cmd_reject "$@" ;; index) cmd_index "$@" ;;
    status) cmd_status "$@" ;; doctor) cmd_doctor "$@" ;; grep) cmd_grep "$@" ;;
    prune) cmd_prune "$@" ;; markers) cmd_markers "$@" ;; dream) cmd_dream "$@" ;;
    backup) cmd_backup "$@" ;; install-opencode) cmd_install_opencode "$@" ;;
    -v|--version) [ $# -eq 0 ] || die "usage: learn --version"; echo "learn $VERSION" ;;
    -h|--help|help) [ $# -eq 0 ] || die "usage: learn help"; usage ;;
    "") usage >&2; exit 1 ;;
    *) die "unknown command: $cmd (see 'learn help')" ;;
  esac
}

# `exit` on the same line: bash reads a script as it runs, so an edit of this
# file during a long run must not make bash execute whatever bytes now follow.
main "$@"; exit $?
