#!/usr/bin/env bash
set -euo pipefail
VERSION="0.1.0"

# Store root. A relative override is made absolute so later `cd`s do not move it.
LEARN_HOME="${AGENT_LEARNINGS_HOME:-$HOME/.agent-learnings}"
case "$LEARN_HOME" in
  /*) ;;
  *) LEARN_HOME="$(pwd -P)/$LEARN_HOME" ;;
esac
STORE_HOME="$LEARN_HOME"

AREAS="test build deps git shell edit scope spec ui lang verbosity tool env infra"
KINDS="correction failure confirmation workflow"

usage() {
  cat <<'EOF'
usage: learn <command> [args]        (learn --version prints the version)

commands:
  init [profile]                            set up the store and .learnings/ for this project (user-only)
  inbox [--since <ts>] [--kind k] [--tier t] [--all] [--json]
                                            show plugin events (unacked by default)
  ack [--until <ts>]                        mark the inbox as processed
  add --key <area.symptom> --kind <k> --summary "<=120" --evidence "..." [--project p] [--behavior "..."] [--owner o]
                                            create a candidate (seen: 1)
  bump <key> --evidence "..." [--project p] another sighting of a candidate
  propose <key> [--owner <o>]               status: proposed
  apply <key> --owner <o> --change-ref <r>  move to applied/ (only after user approval)
  reject <key> --reason "..."               move to rejected/
  index                                     rebuild INDEX.md from candidates/
  status                                    profile, counts, unacked inbox, git state
  doctor                                    check symlink, frontmatter, index, markers
  grep <pattern> [grep opts]                search candidates/applied/rejected
  prune [--days 90]                         seen=1 and idle candidates -> rejected (reason: stale);
                                            also deletes acked inbox/*.jsonl older than --days
  markers list | add --tier <t> "<re>" | test "<text>"
  backup [--push]                           commit (and push) the store
  install-opencode                          install the global OpenCode plugin
EOF
}

die() { echo "learn: $*" >&2; exit 1; }
warn() { echo "learn: $*" >&2; }

canonical_path() {
  local path="$1" dir target
  while [ -L "$path" ]; do
    dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
    target="$(readlink "$path")"
    case "$target" in /*) path="$target" ;; *) path="$dir/$target" ;; esac
  done
  dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

SCRIPT_PATH="$(canonical_path "${BASH_SOURCE[0]}")" || die "cannot resolve CLI path"
SKILL_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
OPENCODE_DIR="$SKILL_DIR/opencode"

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------

valid_slug() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }
valid_key() { [[ "$1" =~ ^[a-z]+\.[a-z0-9-]+$ ]]; }
valid_owner() { [[ "$1" =~ ^(script|skill|new-skill|agents):.+ ]]; }

require_slug() {
  valid_slug "$2" || die "invalid $1 '$2': use lowercase letters, digits, and hyphens"
}

in_list() {   # in_list <word> <space separated list>
  case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Collapse newlines/tabs to spaces and trim, so values stay on one line.
oneline() {
  local s
  s="$(printf '%s' "$1" | tr '\n\r\t' '   ')"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Length in characters (not bytes) of a UTF-8 string: count non-continuation bytes.
char_len() {
  printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

is_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

valid_calendar_date() {
  local date="$1" year month day rest y d max
  case "$date" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) return 1 ;;
  esac
  year="${date%%-*}"
  rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  d=$((10#$day))
  case "$month" in
    01|03|05|07|08|10|12) max=31 ;;
    04|06|09|11) max=30 ;;
    02)
      y=$((10#$year))
      if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then
        max=29
      else
        max=28
      fi
      ;;
    *) return 1 ;;
  esac
  [ "$d" -ge 1 ] && [ "$d" -le "$max" ]
}

# Days-from-civil: monotonic day number for a validated YYYY-MM-DD date.
days_from_civil() {
  local date="$1" year month day y m d era yoe mp doy doe rest
  year="${date%%-*}"
  rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  y=$((10#$year)); m=$((10#$month)); d=$((10#$day))
  if [ "$m" -le 2 ]; then y=$((y - 1)); fi
  if [ "$y" -ge 0 ]; then era=$((y / 400)); else era=$(((y - 399) / 400)); fi
  yoe=$((y - era * 400))
  mp=$(((m + 9) % 12))
  doy=$(((153 * mp + 2) / 5 + d - 1))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  echo $((era * 146097 + doe - 719468))
}

today() {
  if [ -n "${LEARN_TODAY:-}" ]; then
    valid_calendar_date "$LEARN_TODAY" || die "invalid LEARN_TODAY: $LEARN_TODAY"
    printf '%s' "$LEARN_TODAY"
  else
    date +%Y-%m-%d
  fi
}

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Temp file next to its destination so the final mv is an atomic rename.
mk_tmp() {
  local t
  t="$(mktemp "$1/.learn.XXXXXX")" || die "cannot create temporary file in $1"
  chmod 644 "$t"
  printf '%s\n' "$t"
}

# ---------------------------------------------------------------------------
# store / profile resolution
# ---------------------------------------------------------------------------

is_in_store() {
  case "$1" in "$STORE_HOME"|"$STORE_HOME"/*) return 0 ;; *) return 1 ;; esac
}

load_store() {
  [ -d "$LEARN_HOME" ] || die "no store at $LEARN_HOME (ask the user to run: learn init <profile>)"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
}

# Sets PROFILE and PDIR (canonical profile dir) from ./.learnings.
resolve_profile() {
  local target
  [ -L .learnings ] || die "no .learnings symlink here (ask the user to run: learn init <profile>)"
  load_store
  target="$(readlink .learnings)"
  PROFILE="$(basename "$target")"
  [ -d .learnings ] || die "broken .learnings symlink -> $target (ask the user to run: learn init <profile>)"
  PDIR="$(cd -P .learnings && pwd -P)"
  is_in_store "$PDIR" || die "unsafe .learnings symlink: $target is outside $STORE_HOME"
  mkdir -p "$PDIR/inbox" "$PDIR/candidates" "$PDIR/applied" "$PDIR/rejected"
}

default_project() {
  if [ -n "${LEARN_PROJECT:-}" ]; then printf '%s' "$LEARN_PROJECT"; else basename "$(pwd -P)"; fi
}

validate_project() {
  case "$1" in
    ''|*,*|*\[*|*\]*|*$'\n'*) die "invalid project '$1': must be non-empty without commas or brackets" ;;
  esac
}

ensure_global_gitignore() {
  local f origin source
  f="$(git config --global --path --get core.excludesfile 2>/dev/null || true)"
  if [ -z "$f" ]; then
    f="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  else
    case "$f" in
      /*) ;;
      *)
        origin="$(git config --global --show-origin --get core.excludesfile 2>/dev/null || true)"
        source="${origin%%$'\t'*}"
        source="${source#file:}"
        [ -n "$source" ] || die "cannot resolve global core.excludesfile"
        f="$(dirname "$source")/$f"
        ;;
    esac
  fi
  f="${f/#\~/$HOME}"
  if [ -f "$f" ] && grep -qxF '.learnings/' "$f"; then return 0; fi
  mkdir -p "$(dirname "$f")"
  if [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ]; then printf '\n' >> "$f"; fi
  printf '.learnings/\n' >> "$f"
  git config --global core.excludesfile "$f"
  echo "added '.learnings/' to global gitignore ($f)"
}

# ---------------------------------------------------------------------------
# frontmatter
# ---------------------------------------------------------------------------

# Value of one flat frontmatter key; only the first ---...--- block is read.
fm_get() {
  awk -v k="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    /^---$/ { exit }
    index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }
  ' "$1"
}

# Set (replace or append inside the block) one frontmatter key; atomic.
fm_set() {   # fm_set <file> <key> <value>
  local f="$1" tmp
  tmp="$(mk_tmp "$(dirname "$f")")"
  if ! FM_KEY="$2" FM_VAL="$3" awk '
    BEGIN { k = ENVIRON["FM_KEY"]; v = ENVIRON["FM_VAL"]; state = 0; done = 0; bad = 0 }
    NR == 1 { if ($0 != "---") bad = 1; state = 1; print; next }
    state == 1 && /^---$/ { if (!done) { print k ": " v; done = 1 } state = 2; print; next }
    state == 1 && index($0, k ": ") == 1 { if (!done) { print k ": " v; done = 1 } next }
    { print }
    END { if (bad || state != 2) exit 3 }
  ' "$f" > "$tmp"; then
    rm -f "$tmp"
    die "cannot update frontmatter of $f"
  fi
  mv "$tmp" "$f"
}

# Append a line to the file (creating "## Evidence" when absent); atomic.
append_evidence() {   # append_evidence <file> <line>
  local f="$1" tmp
  tmp="$(mk_tmp "$(dirname "$f")")"
  cat "$f" > "$tmp"
  if [ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ]; then printf '\n' >> "$tmp"; fi
  if ! grep -q '^## Evidence$' "$tmp"; then printf '\n## Evidence\n' >> "$tmp"; fi
  printf '%s\n' "$2" >> "$tmp"
  mv "$tmp" "$f"
}

fm_has_block() {
  awk 'NR == 1 { if ($0 != "---") exit 1; next } /^---$/ { f = 1; exit } END { exit !f }' "$1"
}

# Structural problems that make an entry unusable for INDEX.md. One per line.
entry_problems() {
  local f="$1" base stem v key
  base="$(basename "$f")"; stem="${base%.md}"
  if ! fm_has_block "$f"; then echo "BAD FRONTMATTER (missing or unterminated ---): $f"; return 0; fi
  [ -n "$(fm_get "$f" description)" ] || echo "BAD FRONTMATTER (missing description): $f"
  key="$(fm_get "$f" pattern-key)"
  [ "$key" = "$stem" ] || echo "BAD FRONTMATTER (pattern-key '$key' does not match filename): $f"
  v="$(fm_get "$f" kind)"
  in_list "$v" "$KINDS" || echo "BAD FRONTMATTER (missing or invalid kind '$v'): $f"
  v="$(fm_get "$f" seen)"
  is_uint "$v" || echo "BAD FRONTMATTER (seen is not a number): $f"
  v="$(fm_get "$f" first-seen)"
  valid_calendar_date "$v" || echo "BAD FRONTMATTER (invalid first-seen): $f"
  v="$(fm_get "$f" last-seen)"
  valid_calendar_date "$v" || echo "BAD FRONTMATTER (invalid last-seen): $f"
  return 0
}

# Which directory holds the key: candidates | applied | rejected | (empty).
find_key() {
  local d
  for d in candidates applied rejected; do
    if [ -f "$PDIR/$d/$1.md" ]; then printf '%s' "$d"; return 0; fi
  done
  return 0
}

validate_key() {
  local key="$1" area
  valid_key "$key" || die "invalid key '$key': use <area>.<symptom> (lowercase, digits, hyphens), e.g. test.wrong-cwd"
  area="${key%%.*}"
  in_list "$area" "$AREAS" || warn "warning: area '$area' is not in the vocabulary ($AREAS)"
  return 0
}

# ---------------------------------------------------------------------------
# INDEX.md
# ---------------------------------------------------------------------------

# INDEX.md content: one line per usable candidate, sorted by key (LC_ALL=C).
render_index() {
  local f base key kind seen desc problems
  {
    for f in "$PDIR"/candidates/*.md; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      key="${base%.md}"
      problems="$(entry_problems "$f")"
      if [ -n "$problems" ]; then
        warn "skipping candidates/$base: $(printf '%s' "$problems" | head -n 1)"
        continue
      fi
      kind="$(fm_get "$f" kind)"
      seen="$(fm_get "$f" seen)"
      desc="$(fm_get "$f" description)"
      printf '%s\t- [%s](candidates/%s) — %s ×%s: %s\n' "$key" "$key" "$base" "$kind" "$seen" "$desc"
    done
  } | LC_ALL=C sort -t "$(printf '\t')" -k1,1 | cut -f2-
}

write_index() {
  local tmp
  tmp="$(mk_tmp "$PDIR")"
  if ! render_index > "$tmp"; then rm -f "$tmp"; die "failed to render INDEX.md"; fi
  mv "$tmp" "$PDIR/INDEX.md"
}

cmd_index() {
  [ $# -eq 0 ] || die "usage: learn index"
  resolve_profile
  write_index
  echo "indexed $PROFILE ($(grep -c '^- \[' "$PDIR/INDEX.md" || true) candidates)"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local profile="" item found suggestion target
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "unknown option: $1" ;;
      *)
        [ -z "$profile" ] || die "usage: learn init <profile>"
        profile="$1"; shift ;;
    esac
  done
  if [ -z "$profile" ]; then
    {
      echo "existing profiles:"
      found=0
      if [ -d "$LEARN_HOME" ]; then
        for item in "$LEARN_HOME"/*/; do
          [ -d "$item" ] || continue
          item="${item%/}"
          echo "  $(basename "$item")"
          found=1
        done
      fi
      [ "$found" -eq 1 ] || echo "  (none)"
      target="$(readlink .opencode 2>/dev/null || true)"
      case "$target" in
        */opencode/*)
          suggestion="${target##*/opencode/}"
          suggestion="${suggestion%%/*}"
          [ -z "$suggestion" ] || echo "suggested (from .opencode -> $target): learn init $suggestion"
          ;;
      esac
      echo "usage: learn init <profile>"
    } >&2
    exit 1
  fi
  require_slug "profile name" "$profile"

  mkdir -p "$LEARN_HOME"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
  local pdir="$STORE_HOME/$profile"

  if [ -e .learnings ] || [ -L .learnings ]; then
    [ -L .learnings ] || die ".learnings exists but is not a symlink"
    if [ -d .learnings ]; then
      local existing
      existing="$(cd -P .learnings && pwd -P)"
      [ "$existing" = "$pdir" ] || die ".learnings is bound to $existing; remove it explicitly before initializing '$profile'"
    fi
  fi

  if [ ! -d "$STORE_HOME/.git" ]; then git -C "$STORE_HOME" init -q; fi
  mkdir -p "$pdir/inbox" "$pdir/candidates" "$pdir/applied" "$pdir/rejected"
  [ -f "$pdir/INDEX.md" ] || : > "$pdir/INDEX.md"

  if [ ! -f "$STORE_HOME/markers.json" ]; then
    local seed="$OPENCODE_DIR/markers.personal.default.json" tmp
    tmp="$(mk_tmp "$STORE_HOME")"
    if [ -f "$seed" ]; then
      cat "$seed" > "$tmp"
    else
      printf '%s\n' '{"version":1,"correction":{"strong":[],"medium":[],"weak":[]},"confirmation":[]}' > "$tmp"
    fi
    mv "$tmp" "$STORE_HOME/markers.json"
  fi

  ln -sfn "$pdir" .learnings
  ensure_global_gitignore
  echo "initialized: profile '$profile' at $pdir"
}

# ---------------------------------------------------------------------------
# inbox / ack
# ---------------------------------------------------------------------------

# Filtered inbox events. Usage: inbox_stream <mode raw|compact> <since> <ack> <kind> <tier>
# Timestamps are ISO-8601 UTC strings, so string comparison orders them.
inbox_stream() {
  local f
  local -a files=()
  for f in "$PDIR"/inbox/*.jsonl; do
    [ -e "$f" ] || continue
    files+=("$f")
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  IN_MODE="$1" IN_SINCE="$2" IN_ACK="$3" IN_KIND="$4" IN_TIER="$5" awk '
    function jget(s, name,   pat, i, n, c, out, len) {
      pat = "\"" name "\":\""
      i = index(s, pat)
      if (i == 0) return ""
      i += length(pat)
      len = length(s)
      out = ""
      for (n = i; n <= len; n++) {
        c = substr(s, n, 1)
        if (c == "\\") {
          n++
          c = substr(s, n, 1)
          if (c == "n" || c == "t" || c == "r") c = " "
          out = out c
        } else if (c == "\"") {
          break
        } else {
          out = out c
        }
      }
      return out
    }
    BEGIN {
      mode = ENVIRON["IN_MODE"]; since = ENVIRON["IN_SINCE"]; ack = ENVIRON["IN_ACK"]
      wkind = ENVIRON["IN_KIND"]; wtier = ENVIRON["IN_TIER"]
    }
    /^[[:space:]]*$/ { next }
    {
      ts = jget($0, "ts"); kind = jget($0, "kind"); tier = jget($0, "tier")
      if (since != "" && ts < since) next
      if (ack != "" && ts <= ack) next
      if (wkind != "" && kind != wkind) next
      if (wtier != "" && tier != wtier) next
      if (mode == "raw") { print; next }
      project = jget($0, "project")
      if (kind == "failure") {
        text = jget($0, "tool") ": " jget($0, "head")
      } else {
        text = jget($0, "snippet")
        prev = jget($0, "prev_tool")
        if (prev != "") text = text "  (after " prev ")"
      }
      label = kind
      if (tier != "") label = kind "/" tier
      print ts "  " label "  " project "  " text
    }
  ' "${files[@]}"
}

read_ack() {
  local ack=""
  if [ -f "$PDIR/inbox/.ack" ]; then IFS= read -r ack < "$PDIR/inbox/.ack" || true; fi
  printf '%s' "$ack"
}

cmd_inbox() {
  local since="" kind="" tier="" all=0 json=0 ack out maxts
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) [ $# -ge 2 ] || die "--since requires a value"; since="$2"; shift 2 ;;
      --kind) [ $# -ge 2 ] || die "--kind requires a value"; kind="$2"; shift 2 ;;
      --tier) [ $# -ge 2 ] || die "--tier requires a value"; tier="$2"; shift 2 ;;
      --all) all=1; shift ;;
      --json) json=1; shift ;;
      *) die "usage: learn inbox [--since <ts>] [--kind k] [--tier t] [--all] [--json]" ;;
    esac
  done
  resolve_profile
  ack=""
  if [ "$all" -eq 0 ]; then ack="$(read_ack)"; fi
  if [ "$json" -eq 1 ]; then
    inbox_stream raw "$since" "$ack" "$kind" "$tier"
  else
    out="$(inbox_stream compact "$since" "$ack" "$kind" "$tier")"
    if [ -n "$out" ]; then
      printf '%s\n' "$out"
      maxts="$(printf '%s\n' "$out" | awk '{ print $1 }' | LC_ALL=C sort | tail -n 1)"
      echo "ack: learn ack --until $maxts" >&2
    else
      echo "(no events)"
    fi
  fi
}

cmd_ack() {
  local until_ts=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --until) [ $# -ge 2 ] || die "--until requires a value"; until_ts="$2"; shift 2 ;;
      *) die "usage: learn ack [--until <ts>]" ;;
    esac
  done
  resolve_profile
  [ -n "$until_ts" ] || until_ts="$(now_utc)"
  [[ "$until_ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]] || die "invalid timestamp '$until_ts': use ISO-8601, e.g. 2026-09-30T12:00:00Z"
  local tmp
  tmp="$(mk_tmp "$PDIR/inbox")"
  printf '%s\n' "$until_ts" > "$tmp"
  mv "$tmp" "$PDIR/inbox/.ack"
  echo "acked inbox until $until_ts"
}

# ---------------------------------------------------------------------------
# candidate lifecycle
# ---------------------------------------------------------------------------

project_listed() {   # project_listed <list "[a, b]"> <project>
  local list="$1" p item
  p="$2"
  list="${list#\[}"; list="${list%\]}"
  local IFS=','
  for item in $list; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [ "$item" = "$p" ] && return 0
  done
  return 1
}

cmd_add() {
  local key="" kind="" summary="" evidence="" project="" behavior="" owner=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --key) [ $# -ge 2 ] || die "--key requires a value"; key="$2"; shift 2 ;;
      --kind) [ $# -ge 2 ] || die "--kind requires a value"; kind="$2"; shift 2 ;;
      --summary) [ $# -ge 2 ] || die "--summary requires a value"; summary="$2"; shift 2 ;;
      --evidence) [ $# -ge 2 ] || die "--evidence requires a value"; evidence="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project requires a value"; project="$2"; shift 2 ;;
      --behavior) [ $# -ge 2 ] || die "--behavior requires a value"; behavior="$2"; shift 2 ;;
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      *) die "usage: learn add --key <area.symptom> --kind <k> --summary \"<=120\" --evidence \"...\" [--project p] [--behavior \"...\"] [--owner o]" ;;
    esac
  done
  [ -n "$key" ] && [ -n "$kind" ] && [ -n "$summary" ] && [ -n "$evidence" ] \
    || die "usage: learn add --key <area.symptom> --kind <k> --summary \"<=120\" --evidence \"...\" [--project p]"
  resolve_profile
  validate_key "$key"
  in_list "$kind" "$KINDS" || die "invalid kind '$kind': use one of: $KINDS"
  summary="$(oneline "$summary")"
  local n
  n="$(char_len "$summary")"
  [ "$n" -le 120 ] || die "summary is $n characters (max 120)"
  [ -n "$summary" ] || die "summary must not be empty"
  evidence="$(oneline "$evidence")"
  [ -n "$evidence" ] || die "evidence must not be empty"
  behavior="$(oneline "$behavior")"
  [ -n "$behavior" ] || behavior="$summary"
  owner="$(oneline "$owner")"
  [ -n "$project" ] || project="$(default_project)"
  validate_project "$project"

  local existing reason o
  existing="$(find_key "$key")"
  case "$existing" in
    candidates) die "candidate '$key' already exists; use: learn bump $key --evidence \"...\"" ;;
    applied)
      o="$(fm_get "$PDIR/applied/$key.md" owner)"
      die "'$key' is already applied (owner: ${o:-unknown}); applied patterns never grow" ;;
    rejected)
      reason="$(fm_get "$PDIR/rejected/$key.md" reason)"
      if [ "$reason" = "stale" ]; then
        rm -f "$PDIR/rejected/$key.md"
      else
        die "'$key' was rejected (reason: ${reason:-unknown}); delete rejected/$key.md to re-add it"
      fi ;;
  esac

  local day tmp
  day="$(today)"
  tmp="$(mk_tmp "$PDIR/candidates")"
  {
    echo "---"
    echo "description: $summary"
    echo "pattern-key: $key"
    echo "kind: $kind"
    echo "seen: 1"
    echo "first-seen: $day"
    echo "last-seen: $day"
    echo "projects: [$project]"
    if [ -n "$owner" ]; then echo "suggested-owner: $owner"; fi
    echo "status: candidate"
    echo "---"
    echo "## Future behavior"
    echo "$behavior"
    echo ""
    echo "## Evidence"
    echo "- $day $project: $evidence"
  } > "$tmp"
  mv "$tmp" "$PDIR/candidates/$key.md"
  write_index
  echo "added candidates/$key.md"
}

cmd_bump() {
  local key="" evidence="" project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --evidence) [ $# -ge 2 ] || die "--evidence requires a value"; evidence="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project requires a value"; project="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn bump <key> --evidence \"...\" [--project p]"; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] && [ -n "$evidence" ] || die "usage: learn bump <key> --evidence \"...\" [--project p]"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  evidence="$(oneline "$evidence")"
  [ -n "$evidence" ] || die "evidence must not be empty"
  [ -n "$project" ] || project="$(default_project)"
  validate_project "$project"

  local existing o ref reason f seen projects day
  existing="$(find_key "$key")"
  case "$existing" in
    applied)
      o="$(fm_get "$PDIR/applied/$key.md" owner)"
      ref="$(fm_get "$PDIR/applied/$key.md" change-ref)"
      die "'$key' is already applied (owner: ${o:-unknown}, change-ref: ${ref:-unknown}); applied patterns never grow — if the behavior regressed, fix the owner" ;;
    rejected)
      reason="$(fm_get "$PDIR/rejected/$key.md" reason)"
      die "'$key' was rejected (reason: ${reason:-unknown}); not bumping" ;;
    "") die "no candidate '$key' (create it with: learn add --key $key ...)" ;;
  esac
  f="$PDIR/candidates/$key.md"
  seen="$(fm_get "$f" seen)"
  is_uint "$seen" || die "candidate $key has invalid seen: '$seen' (run 'learn doctor')"
  day="$(today)"
  fm_set "$f" seen "$((seen + 1))"
  fm_set "$f" last-seen "$day"
  projects="$(fm_get "$f" projects)"
  if ! project_listed "$projects" "$project"; then
    projects="${projects#\[}"; projects="${projects%\]}"
    if [ -n "$projects" ]; then projects="$projects, $project"; else projects="$project"; fi
    fm_set "$f" projects "[$projects]"
  fi
  append_evidence "$f" "- $day $project: $evidence"
  write_index
  echo "bumped $key (seen: $((seen + 1)))"
}

cmd_propose() {
  local key="" owner=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn propose <key> [--owner <o>]"; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] || die "usage: learn propose <key> [--owner <o>]"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  [ -f "$PDIR/candidates/$key.md" ] || die "no candidate '$key'"
  owner="$(oneline "$owner")"
  fm_set "$PDIR/candidates/$key.md" status proposed
  if [ -n "$owner" ]; then fm_set "$PDIR/candidates/$key.md" suggested-owner "$owner"; fi
  write_index
  echo "proposed $key"
}

cmd_apply() {
  local key="" owner="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) [ $# -ge 2 ] || die "--owner requires a value"; owner="$2"; shift 2 ;;
      --change-ref) [ $# -ge 2 ] || die "--change-ref requires a value"; ref="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn apply <key> --owner <o> --change-ref <r>"; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] && [ -n "$owner" ] && [ -n "$ref" ] || die "usage: learn apply <key> --owner <o> --change-ref <r>"
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  owner="$(oneline "$owner")"
  valid_owner "$owner" || die "invalid owner '$owner': use script:<path> | skill:<name> | new-skill:<name> | agents:<repo>"
  ref="$(oneline "$ref")"
  local existing
  existing="$(find_key "$key")"
  case "$existing" in
    candidates) ;;
    applied) die "'$key' is already applied" ;;
    rejected) die "'$key' was rejected; cannot apply" ;;
    *) die "no candidate '$key'" ;;
  esac
  local f="$PDIR/candidates/$key.md"
  fm_set "$f" owner "$owner"
  fm_set "$f" change-ref "$ref"
  fm_set "$f" applied-at "$(today)"
  fm_set "$f" status applied
  mv "$f" "$PDIR/applied/$key.md"
  write_index
  echo "applied $key -> $owner"
}

cmd_reject() {
  local key="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason) [ $# -ge 2 ] || die "--reason requires a value"; reason="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$key" ] || die "usage: learn reject <key> --reason \"...\""; key="$1"; shift ;;
    esac
  done
  [ -n "$key" ] && [ -n "$reason" ] || die "usage: learn reject <key> --reason \"...\""
  resolve_profile
  valid_key "$key" || die "invalid key '$key'"
  reason="$(oneline "$reason")"
  [ -n "$reason" ] || die "reason must not be empty"
  [ -f "$PDIR/candidates/$key.md" ] || die "no candidate '$key'"
  local f="$PDIR/candidates/$key.md"
  fm_set "$f" reason "$reason"
  fm_set "$f" status rejected
  mv "$f" "$PDIR/rejected/$key.md"
  write_index
  echo "rejected $key"
}

cmd_prune() {
  local days=90 f key seen last status age now_days moved=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) [ $# -ge 2 ] || die "--days requires a value"; days="$2"; shift 2 ;;
      *) die "usage: learn prune [--days N]" ;;
    esac
  done
  is_uint "$days" || die "--days must be a non-negative integer"
  days=$((10#$days))
  resolve_profile
  now_days="$(days_from_civil "$(today)")"
  for f in "$PDIR"/candidates/*.md; do
    [ -e "$f" ] || continue
    key="$(basename "$f" .md)"
    seen="$(fm_get "$f" seen)"
    [ "$seen" = "1" ] || continue
    status="$(fm_get "$f" status)"
    [ "$status" = "candidate" ] || continue
    last="$(fm_get "$f" last-seen)"
    if ! valid_calendar_date "$last"; then warn "skipping $key: invalid last-seen '$last'"; continue; fi
    age=$((now_days - $(days_from_civil "$last")))
    if [ "$age" -gt "$days" ]; then
      fm_set "$f" reason stale
      fm_set "$f" status rejected
      mv "$f" "$PDIR/rejected/$key.md"
      echo "pruned $key (${age}d idle)"
      moved=$((moved + 1))
    fi
  done
  write_index
  echo "pruned $moved candidate(s)"

  # Acked inbox files: filename date older than (ack date - days) means every event is acked and stale.
  local ack ack_date ack_days fdate removed=0
  ack="$(read_ack)"
  ack_date="${ack:0:10}"
  if valid_calendar_date "$ack_date"; then
    ack_days="$(days_from_civil "$ack_date")"
    for f in "$PDIR"/inbox/*.jsonl; do
      [ -e "$f" ] || continue
      fdate="$(basename "$f" .jsonl)"
      valid_calendar_date "$fdate" || continue
      if [ "$(days_from_civil "$fdate")" -lt $((ack_days - days)) ]; then
        rm -f "$f"
        removed=$((removed + 1))
      fi
    done
  fi
  echo "removed $removed acked inbox file(s)"
}

# ---------------------------------------------------------------------------
# status / doctor / grep
# ---------------------------------------------------------------------------

count_md() {
  local n=0 f
  for f in "$1"/*.md; do
    [ -e "$f" ] || continue
    n=$((n + 1))
  done
  echo "$n"
}

cmd_status() {
  [ $# -eq 0 ] || die "usage: learn status"
  resolve_profile
  local unacked ack dirty top
  ack="$(read_ack)"
  unacked="$(inbox_stream raw "" "$ack" "" "" | grep -c '' || true)"
  echo "store:      $STORE_HOME"
  echo "profile:    $PROFILE  -> $PDIR"
  echo "candidates: $(count_md "$PDIR/candidates")"
  echo "applied:    $(count_md "$PDIR/applied")"
  echo "rejected:   $(count_md "$PDIR/rejected")"
  echo "inbox:      $unacked unacked event(s)"
  top="$(git -C "$STORE_HOME" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && top="$(cd -P "$top" && pwd -P)" && [ "$top" = "$STORE_HOME" ]; then
    dirty="$(git -C "$STORE_HOME" status --porcelain --untracked-files=all | wc -l | tr -d ' ')"
    if [ "$dirty" -eq 0 ]; then echo "git:        clean"; else echo "git:        $dirty uncommitted path(s) — run 'learn backup'"; fi
  else
    echo "git:        unavailable (store is not a git repository)"
  fi
}

DOC_PROBLEMS=0
dprob() { echo "$*"; DOC_PROBLEMS=$((DOC_PROBLEMS + 1)); }

doctor_dir_checks() {   # doctor_dir_checks <dirname>
  local d="$1" f base key v area desc n status p
  for f in "$PDIR/$d"/*.md; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    key="${base%.md}"
    p="$(entry_problems "$f")"
    if [ -n "$p" ]; then
      while IFS= read -r line; do dprob "$line"; done <<< "$p"
      continue
    fi
    desc="$(fm_get "$f" description)"
    n="$(char_len "$desc")"
    if [ "$n" -gt 120 ]; then dprob "LONG DESCRIPTION ($n chars > 120): $d/$base"; fi
    if ! valid_key "$key"; then
      dprob "BAD KEY (expected <area>.<symptom>): $d/$base"
    else
      area="${key%%.*}"
      in_list "$area" "$AREAS" || echo "warning: area '$area' not in vocabulary: $d/$base"
    fi
    status="$(fm_get "$f" status)"
    case "$d" in
      candidates)
        case "$status" in
          candidate|proposed|open-question) ;;
          *) dprob "BAD STATUS ('$status' in candidates/): $d/$base" ;;
        esac ;;
      applied)
        [ "$status" = "applied" ] || dprob "BAD STATUS ('$status' in applied/): $d/$base"
        for v in owner change-ref applied-at; do
          [ -n "$(fm_get "$f" "$v")" ] || dprob "APPLIED MISSING $v: $d/$base"
        done
        v="$(fm_get "$f" owner)"
        if [ -n "$v" ] && ! valid_owner "$v"; then dprob "BAD OWNER ('$v'; use script:|skill:|new-skill:|agents:): $d/$base"; fi ;;
      rejected)
        [ "$status" = "rejected" ] || dprob "BAD STATUS ('$status' in rejected/): $d/$base"
        [ -n "$(fm_get "$f" reason)" ] || dprob "REJECTED MISSING reason: $d/$base" ;;
    esac
  done
}

cmd_doctor() {
  [ $# -eq 0 ] || die "usage: learn doctor"
  local target resolved d expected actual f
  DOC_PROBLEMS=0
  if [ ! -e .learnings ] && [ ! -L .learnings ]; then
    die "no .learnings symlink here (ask the user to run: learn init <profile>)"
  fi
  if [ ! -d "$LEARN_HOME" ]; then dprob "STORE MISSING: $LEARN_HOME"; echo "problems: $DOC_PROBLEMS"; exit 1; fi
  load_store
  if [ ! -L .learnings ]; then
    dprob "NOT A SYMLINK: .learnings"
  else
    target="$(readlink .learnings)"
    case "$target" in
      /*) ;;
      *) dprob "UNSAFE SYMLINK: .learnings -> $target (relative target)" ;;
    esac
    if [ ! -d .learnings ]; then
      dprob "BROKEN: .learnings -> $target"
    else
      resolved="$(cd -P .learnings && pwd -P)"
      if ! is_in_store "$resolved"; then
        dprob "UNSAFE SYMLINK: .learnings -> $target (outside $STORE_HOME)"
      else
        PDIR="$resolved"
        PROFILE="$(basename "$target")"
        for d in inbox candidates applied rejected; do
          [ -d "$PDIR/$d" ] || echo "warning: missing directory $d/ (created on first use)"
        done
        for d in candidates applied rejected; do doctor_dir_checks "$d"; done
        if [ ! -f "$PDIR/INDEX.md" ]; then
          dprob "MISSING INDEX: $PDIR/INDEX.md (run 'learn index')"
        else
          expected="$(render_index 2>/dev/null || true)"
          actual="$(<"$PDIR/INDEX.md")"
          [ "$expected" = "$actual" ] || dprob "INDEX DRIFT: INDEX.md differs from candidates/ (run 'learn index')"
        fi
        for f in "$PDIR"/applied/*.md; do
          [ -e "$f" ] || continue
          if [ -f "$PDIR/candidates/$(basename "$f")" ]; then
            dprob "DUPLICATE KEY (in candidates/ and applied/): $(basename "$f" .md)"
          fi
        done
      fi
    fi
  fi
  # markers.json
  if [ -f "$STORE_HOME/markers.json" ]; then
    local merrs line
    if ! merrs="$(validate_markers_file "$STORE_HOME/markers.json")"; then
      while IFS= read -r line; do dprob "BAD MARKERS: $line"; done <<< "$merrs"
    fi
  else
    echo "warning: $STORE_HOME/markers.json missing (run 'learn init <profile>')"
  fi
  if [ "$DOC_PROBLEMS" -gt 0 ]; then die "problems found ($DOC_PROBLEMS)"; fi
  echo "OK"
}

cmd_grep() {
  [ $# -ge 1 ] || die "usage: learn grep <pattern> [extra grep options]"
  resolve_profile
  local pattern="$1" rc=0
  shift
  (cd "$PDIR" && grep -r -n -i "$@" -- "$pattern" candidates applied rejected) || rc=$?
  case "$rc" in
    0) ;;
    1) echo "no matches for '$pattern'" ;;
    *) die "grep failed (exit $rc)" ;;
  esac
}

# ---------------------------------------------------------------------------
# markers
# ---------------------------------------------------------------------------

# Validate a markers JSON file via learn-core.js validateMarkers(json) (array of
# error strings, empty = ok). Errors go to stdout, one per line; returns 1 if any.
# Without node, learn-core.js, or the export: JSON-syntax check only (with a warning).
validate_markers_file() {   # validate_markers_file <file>
  local out rc=0
  if ! command -v node >/dev/null 2>&1; then
    warn "warning: node not found; markers not validated"
    return 0
  fi
  out="$(L_FILE="$1" L_CORE="$OPENCODE_DIR/learn-core.js" node -e '
    const fs = require("fs");
    const { pathToFileURL } = require("url");
    let j;
    try { j = JSON.parse(fs.readFileSync(process.env.L_FILE, "utf8")); }
    catch (e) { console.log("not valid JSON: " + e.message); process.exit(1); }
    import(pathToFileURL(process.env.L_CORE).href).then((m) => {
      if (typeof m.validateMarkers !== "function") {
        console.error("learn: warning: validateMarkers unavailable in learn-core.js; only JSON syntax checked");
        return;
      }
      const errs = m.validateMarkers(j) || [];
      if (errs.length) { for (const e of errs) console.log(e); process.exit(1); }
    }).catch((e) => {
      console.error("learn: warning: cannot load learn-core.js (" + (e && e.message ? e.message : e) + "); only JSON syntax checked");
    });
  ')" || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ -n "$out" ] || out="markers validation failed (exit $rc)"
    printf '%s\n' "$out"
    return 1
  fi
  return 0
}

cmd_markers() {
  local sub="${1:-}"
  [ $# -eq 0 ] || shift
  local default_file="$OPENCODE_DIR/markers.default.json"
  local personal_file
  load_store
  personal_file="$STORE_HOME/markers.json"
  case "$sub" in
    list)
      [ $# -eq 0 ] || die "usage: learn markers list"
      command -v node >/dev/null 2>&1 || die "node is required for 'markers list'"
      L_DEFAULT="$default_file" L_PERSONAL="$personal_file" node -e '
        const fs = require("fs");
        const rd = (p) => { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch (e) { if (e.code === "ENOENT") return null; throw e; } };
        const d = rd(process.env.L_DEFAULT), p = rd(process.env.L_PERSONAL);
        const groups = [
          ["correction/strong", (x) => x && x.correction && x.correction.strong],
          ["correction/medium", (x) => x && x.correction && x.correction.medium],
          ["correction/weak", (x) => x && x.correction && x.correction.weak],
          ["confirmation", (x) => x && x.confirmation],
        ];
        for (const [name, get] of groups) {
          console.log(name + ":");
          for (const [label, x] of [["default", d], ["personal", p]])
            for (const m of (get(x) || [])) console.log("  [" + label + "] " + m);
        }
      ' || die "cannot read markers (invalid JSON?)"
      ;;
    add)
      local tier="" re=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --tier) [ $# -ge 2 ] || die "--tier requires a value"; tier="$2"; shift 2 ;;
          -*) die "unknown option: $1" ;;
          *) [ -z "$re" ] || die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\""; re="$1"; shift ;;
        esac
      done
      case "$tier" in strong|medium|weak|confirmation) ;; *) die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\"" ;; esac
      [ -n "$re" ] || die "usage: learn markers add --tier strong|medium|weak|confirmation \"<re>\""
      command -v node >/dev/null 2>&1 || die "node is required for 'markers add'"
      local mtmp="$personal_file.tmp.$$" merrs
      rm -f "$mtmp"
      L_FILE="$personal_file" L_TMP="$mtmp" L_TIER="$tier" L_RE="$re" node -e '
        const fs = require("fs");
        const f = process.env.L_FILE, t = process.env.L_TIER, re = process.env.L_RE;
        let j;
        try { j = JSON.parse(fs.readFileSync(f, "utf8")); }
        catch (e) {
          if (e.code !== "ENOENT") { console.error("markers.json is not valid JSON: " + e.message); process.exit(3); }
          j = { version: 1, correction: { strong: [], medium: [], weak: [] }, confirmation: [] };
        }
        j.version = j.version || 1;
        j.correction = j.correction || {};
        let arr;
        if (t === "confirmation") arr = (j.confirmation = j.confirmation || []);
        else arr = (j.correction[t] = j.correction[t] || []);
        if (arr.includes(re)) { console.log("already present in " + t); process.exit(0); }
        arr.push(re);
        fs.writeFileSync(process.env.L_TMP, JSON.stringify(j, null, 2) + "\n");
      ' || { rm -f "$mtmp"; die "could not add marker"; }
      if [ -f "$mtmp" ]; then
        if ! merrs="$(validate_markers_file "$mtmp")"; then
          rm -f "$mtmp"
          die "could not add marker: $merrs"
        fi
        mv "$mtmp" "$personal_file"
        echo "added to $tier: $re"
      fi
      ;;
    test)
      [ $# -eq 1 ] || die "usage: learn markers test \"<text>\""
      command -v node >/dev/null 2>&1 || die "node is required for 'markers test'"
      [ -f "$OPENCODE_DIR/learn-core.js" ] || die "learn-core.js not found at $OPENCODE_DIR"
      L_CORE="$OPENCODE_DIR/learn-core.js" L_DEFAULT="$default_file" L_PERSONAL="$personal_file" L_TEXT="$1" node -e '
        const { pathToFileURL } = require("url");
        import(pathToFileURL(process.env.L_CORE).href).then(async (m) => {
          const markers = await m.loadMarkers(process.env.L_DEFAULT, process.env.L_PERSONAL);
          const r = await m.matchMarkers(process.env.L_TEXT, markers);
          if (!r) { console.log("no match"); return; }
          const src = r.marker && r.marker.source ? r.marker.source : String(r.marker);
          console.log((r.tier || r.role) + "\t" + src);
        }).catch((e) => { console.error(e && e.message ? e.message : String(e)); process.exit(1); });
      ' || die "markers test failed"
      ;;
    *) die "usage: learn markers list | add --tier <t> \"<re>\" | test \"<text>\"" ;;
  esac
}

# ---------------------------------------------------------------------------
# backup / install
# ---------------------------------------------------------------------------

# Counts from the staged diff: "added bumped applied rejected".
backup_counts() {
  git -C "$STORE_HOME" diff --cached --name-status -M | awk -F'\t' '
    {
      c = substr($1, 1, 1); p = $NF
      if (p ~ /^[^\/]+\/candidates\/[^\/]+\.md$/) {
        if (c == "A") add++
        else if (c == "M") bump++
      } else if (p ~ /^[^\/]+\/applied\/[^\/]+\.md$/) {
        if (c == "A" || c == "R") applied++
      } else if (p ~ /^[^\/]+\/rejected\/[^\/]+\.md$/) {
        if (c == "A" || c == "R") rej++
      }
    }
    END { printf "%d %d %d %d\n", add, bump, applied, rej }
  '
}

cmd_backup() {
  local push=0 profile="" target counts add bump applied rej msg subject
  case "$#" in 0) ;; 1) [ "$1" = "--push" ] || die "usage: learn backup [--push]"; push=1 ;; *) die "usage: learn backup [--push]" ;; esac
  [ -d "$LEARN_HOME/.git" ] || die "no store at $LEARN_HOME (ask the user to run: learn init <profile>)"
  STORE_HOME="$(cd -P "$LEARN_HOME" && pwd -P)"
  if [ -L .learnings ]; then
    target="$(readlink .learnings)"
    profile="$(basename "$target")"
  fi
  git -C "$STORE_HOME" add -A
  if git -C "$STORE_HOME" diff --cached --quiet 2>/dev/null && git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    echo "nothing to back up"
  else
    counts="$(backup_counts)"
    read -r add bump applied rej <<< "$counts"
    if [ -n "$profile" ]; then subject="learn($profile): "; else subject="learn: "; fi
    if [ "$add" -eq 0 ] && [ "$bump" -eq 0 ] && [ "$applied" -eq 0 ] && [ "$rej" -eq 0 ]; then
      msg="${subject}inbox update"
    else
      msg="${subject}+$add candidates, ~$bump bumped, →$applied applied"
      if [ "$rej" -gt 0 ]; then msg="$msg, -$rej rejected"; fi
    fi
    git -C "$STORE_HOME" commit -q -m "$msg" \
      || die "commit failed in $STORE_HOME — is git user.name / user.email configured?"
    echo "backed up: $msg"
  fi
  if [ "$push" -eq 1 ]; then
    git -C "$STORE_HOME" remote get-url origin >/dev/null 2>&1 || die "no remote configured (git -C $STORE_HOME remote add origin <url>)"
    git -C "$STORE_HOME" push -q origin HEAD
  fi
}

cmd_install_opencode() {
  [ $# -eq 0 ] || die "usage: learn install-opencode"
  local source config_dir destination current
  source="$OPENCODE_DIR/self-improving.js"
  [ -f "$source" ] || die "OpenCode plugin not found at $source"
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins"
  destination="$config_dir/self-improving.js"
  mkdir -p "$config_dir"
  if [ -L "$destination" ]; then
    current="$(canonical_path "$destination" 2>/dev/null)" || current=""   # dangling link: replace it
    if [ "$current" = "$source" ]; then echo "OpenCode plugin already installed: $destination"; return 0; fi
    rm "$destination"
  elif [ -e "$destination" ]; then
    die "refusing to overwrite non-symlink: $destination"
  fi
  ln -sfn "$source" "$destination"
  echo "installed OpenCode plugin: $destination (restart OpenCode to load it)"
}

main() {
  local cmd="${1:-}"
  if [ $# -gt 0 ]; then shift; fi
  case "$cmd" in
    init) cmd_init "$@" ;; inbox) cmd_inbox "$@" ;; ack) cmd_ack "$@" ;;
    add) cmd_add "$@" ;; bump) cmd_bump "$@" ;; propose) cmd_propose "$@" ;;
    apply) cmd_apply "$@" ;; reject) cmd_reject "$@" ;; index) cmd_index "$@" ;;
    status) cmd_status "$@" ;; doctor) cmd_doctor "$@" ;; grep) cmd_grep "$@" ;;
    prune) cmd_prune "$@" ;; markers) cmd_markers "$@" ;;
    backup) cmd_backup "$@" ;; install-opencode) cmd_install_opencode "$@" ;;
    -v|--version) [ $# -eq 0 ] || die "usage: learn --version"; echo "learn $VERSION" ;;
    -h|--help|help) [ $# -eq 0 ] || die "usage: learn help"; usage ;;
    "") usage >&2; exit 1 ;;
    *) die "unknown command: $cmd (see 'learn help')" ;;
  esac
}

# `exit` on the same line: bash reads a script as it runs, so an edit of this
# file during a long run must not make bash execute whatever bytes now follow.
main "$@"; exit $?
